{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://swof.local/schemas/assurance/acceptance_predicate.schema.json",
 "title": "AcceptancePredicate - the falsifiable unit of assurance (closed)",
 "description": "Shape of an acceptance predicate. The decision law is enforced in src/assurance/predicate.py and NOT expressible here: empty required_evidence_kinds, empty negative_fixtures, an unknown subject_type or fewer than two terminal_states are refused as ERR_PREDICATE_INVALID because a predicate that cannot fail is not a predicate. This schema is closed: unknown properties are rejected.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "predicate_id",
  "subject_id",
  "subject_type",
  "required_evidence_kinds",
  "oracle_id",
  "terminal_states",
  "negative_fixtures"
 ],
 "properties": {
  "predicate_id": {
   "type": "string",
   "minLength": 1
  },
  "subject_id": {
   "type": "string",
   "minLength": 1
  },
  "subject_type": {
   "enum": [
    "DELIVERABLE",
    "CAPABILITY",
    "JOURNEY",
    "REQUIREMENT"
   ]
  },
  "required_evidence_kinds": {
   "type": "array",
   "minItems": 1,
   "uniqueItems": true,
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "oracle_id": {
   "type": "string",
   "minLength": 1
  },
  "terminal_states": {
   "type": "array",
   "minItems": 2,
   "uniqueItems": true,
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "negative_fixtures": {
   "type": "array",
   "minItems": 1,
   "uniqueItems": true,
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "raw_evidence_required": {
   "type": "boolean"
  },
  "independent_checker_required": {
   "type": "boolean"
  }
 }
}