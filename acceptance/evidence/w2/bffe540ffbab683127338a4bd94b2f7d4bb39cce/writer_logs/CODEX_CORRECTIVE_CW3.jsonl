    4086\r\nC:\\Projects\\Agent_Workspace\\SWOF\\src\\observability\\recovery.py                 5459\r\nC:\\Projects\\Agent_Workspace\\SWOF\\src\\observability\\redaction.py                5705\r\nC:\\Projects\\Agent_Workspace\\SWOF\\src\\observability\\tests\\__init__.py             54\r\nC:\\Projects\\Agent_Workspace\\SWOF\\src\\observability\\tests\\test_adversarial.py   5724\r\nC:\\Projects\\Agent_Workspace\\SWOF\\src\\observability\\tests\\test_correlation.py   4501\r\nC:\\Projects\\Agent_Workspace\\SWOF\\src\\observability\\tests\\test_hooks.py         7850\r\nC:\\Projects\\Agent_Workspace\\SWOF\\src\\observability\\tests\\test_recovery.py      6613\r\nC:\\Projects\\Agent_Workspace\\SWOF\\src\\observability\\tests\\test_redaction.py     3641\r\n\r\n","exit_code":0,"status":"completed"}}
