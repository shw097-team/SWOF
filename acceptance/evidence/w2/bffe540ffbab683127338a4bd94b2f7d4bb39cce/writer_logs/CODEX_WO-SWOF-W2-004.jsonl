ay path: an out-of-set path is a defect to be deleted and receipted, not an entry to be added.\\\",\n    \\\"invariants\\\": [\n        \\\"no second semantic root (PI-PKG-00 2.3)\\\",\n        \\\"provider/execution state is never semantic authority (PI-PKG-00 2.4)\\\",\n        \\\"no credential capture in this repository\\\"\n    ]\n}\n\ntext = json.dumps(doc, indent=1, ensure_ascii=True)\nwith open(\\\"config/workspace.json\\\", \\\"w\\\", encoding=\\\"utf-8\\\", newline=\\\"\\\\n\\\") as handle:\n    handle.write(text + \\\"\\\\n\\\")\n\n# re-read and prove the two W0-invariant values survive verbatim\ncheck = json.load(open(\\\"config/workspace.json\\\", encoding=\\\"utf-8\\\"))\nassert check[\\\"semantic_authority\\\"] is False\nassert check[\\\"repo_role\\\"] == \\\"PRODUCT_ROOT_UNDER_HGK_GOVERNANCE\\\"\nprint(\\\"wrote config/workspace.json; json valid; invariants intact\\\")\n'@\n\"'$py | python -\n$b=[System.IO.File]::ReadAllBytes(\"C:'\"\\\\Projects\\\\Agent_Workspace\\\\SWOF\\\\config\\\\workspace.json\\\"); \\\"nonascii=\"'$((($b | Where-Object {$_ -gt 127})).Count) crlf=$((($b | Where-Object {$_ -eq 13})).Count)\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
