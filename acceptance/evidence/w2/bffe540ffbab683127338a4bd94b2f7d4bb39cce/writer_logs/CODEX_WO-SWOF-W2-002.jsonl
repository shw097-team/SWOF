{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"\"C:\\\\Users\\\\user\\\\AppData\\\\Local\\\\Microsoft\\\\WindowsApps\\\\pwsh.exe\" -Command \"Get-Content -LiteralPath 'C:\\\\Projects\\\\Agent_Workspace\\\\HG-KSEOS\\\\var\\\\swof-construction-002-w2\\\\w2_07_suite.py' -Raw\"","aggregated_output":"\"\"\"SWOF W2 STEP 7 (cards W2-D5 / W2-D6) - the full test denominator at the W2 candidate HEAD.\n\nTen roots, each discovered SEPARATELY (a single discover call silently skips the co-located\n`src/<subsystem>/tests` roots and turns a small denominator into a vacuous PASS). Both stdout and\nstderr are parsed, and the denominator is asserted non-zero per root.\n\"\"\"\nimport hashlib\nimport json\nimport subprocess\nimport sys\nimport time\nfrom pathlib import Path\n\nHGK = Path(r\"C:\\Projects\\Agent_Workspace\\HG-KSEOS\")\nT = Path(r\"C:\\Projects\\Agent_Workspace\\SWOF\")\nOUT = HGK / \"evidence\" / \"swof-construction-002\" / \"w2_binding_order\"\nRAW = OUT / \"raw_test_logs\"\nPY = HGK / \".venv\" / \"Scripts\" / \"python.exe\"\n\nW1_ROOTS = [(\"tests\", \".\"), (\"src/fabric/tests\", \"src/fabric/tests\"),\n            (\"src/knowledge/tests\", \"src/knowledge/tests\"),\n            (\"src/admission/tests\", \"src/admission/tests\"),\n            (\"src/profile/tests\", \"src/profile/tests\"),\n            (\"src/capability/tests\", \"src/capability/tests\")]\nW2_ROOTS = [(\"src/security/tests\", \"src/security/tests\"),\n            (\"src/effect/tests\", \"src/effect/tests\"),\n            (\"src/assurance/tests\", \"src/assurance/tests\"),\n            (\"src/observability/tests\", \"src/observability/tests\")]\nW1_BASELINE = 113\n\n\ndef git(*a):\n    return subprocess.run([\"git\", *a], cwd=str(T), capture_output=True, text=True, timeout=300)\n\n\ndef sha(p):\n    p = Path(p)\n    return hashlib.sha256(p.read_bytes()).hexdigest() if p.exists() else None\n\n\ndef run(label, root, top, head, phase):\n    started = time.strftime(\"%Y-%m-%dT%H:%M:%SZ\", time.gmtime())\n    t0 = time.time()\n    p = subprocess.run([str(PY), \"-m\", \"unittest\", \"discover\", \"-s\", root, \"-t\", top],\n                       cwd=str(T), capture_output=True, text=True)\n    dur = time.time() - t0\n    combined = (p.stdout or \"\") + \"\\n\" + (p.stderr or \"\")\n    ran, ok = 0, False\n    for line in combined.replace(\"\\r\", \"\\n\").split(\"\\n\"):\n        if line.startswith(\"Ran \") and \" test\" in line:\n            ran = int(line.split()[1])\n        if line.strip() == \"OK\":\n            ok = True\n    log = RAW / f\"{phase}_{root.replace('/', '_')}.log\"\n    log.write_text(f\"# command : {PY} -m unittest discover -s {root} -t {top}\\n# cwd     : {T}\\n\"\n                   f\"# git HEAD: {head}\\n# branch  : {git('rev-parse','--abbrev-ref','HEAD').stdout.strip()}\\n\"\n                   f\"# python  : {sys.version.split()[0]}\\n# phase   : {phase}\\n# started : {started}\\n\"\n                   f\"# duration: {dur:.3f}s\\n# exit_code: {p.returncode}\\n\" + \"-\" * 78 + \"\\n\" + combined,\n                   encoding=\"utf-8\", newline=\"\\n\")\n    return {\"label\": label, \"root\": root, \"ran\": ran, \"exit_code\": p.returncode, \"ok\": ok,\n            \"raw_log\": f\"raw_test_logs/{log.name}\", \"sha256\": sha(log)}\n\n\ndef main():\n    RAW.mkdir(parents=True, exist_ok=True)\n    head = git(\"rev-parse\", \"HEAD\").stdout.strip()\n    branch = git(\"rev-parse\", \"--abbrev-ref\", \"HEAD\").stdout.strip()\n    dirty = [l for l in git(\"status\", \"--porcelain\").stdout.splitlines() if l.strip()]\n    w1 = [run(l, r, t, head, \"w2_candidate_w1\") for l, r, t in W1_ROOTS]\n    w2 = [run(l, r, t, head, \"w2_candidate_w2\") for l, r, t in W2_ROOTS]\n    w1_total = sum(r[\"ran\"] for r in w1)\n    w2_total = sum(r[\"ran\"] for r in w2)\n    doc = {\n        \"schema\": \"SWOF-W2-TEST-DENOMINATOR/1\", \"candidate\": head, \"branch\": branch,\n        \"worktree_clean_at_test_time\": not dirty,\n        \"interpreter\": str(PY), \"python_version\": sys.version.split()[0],\n        \"w1_regression\": {\"roots\": w1, \"total\": w1_total, \"accepted_baseline\": W1_BASELINE,\n                          \"denominator_preserved\": w1_total >= W1_BASELINE,\n                          \"silent_shortfall\": w1_total < W1_BASELINE,\n                          \"all_green\": all(r[\"exit_code\"] == 0 and r[\"ok\"] and r[\"ran\"] > 0 for r in w1)},\n        \"w2_suites\": {\"roots\": w2, \"total\": w2_total,\n                      \"all_green\": all(r[\"exit_code\"] == 0 and r[\"ok\"] and r[\"ran\"] > 0 for r in w2)},\n        \"grand_total\": w1_total + w2_total,\n        \"zero_denominator_roots\": [r[\"root\"] for r in w1 + w2 if r[\"ran\"] == 0],\n        \"aggregate_pass\": (all(r[\"exit_code\"] == 0 and r[\"ok\"] and r[\"ran\"] > 0 for r in w1 + w2)\n                           and w1_total >= W1_BASELINE),\n        \"generated_at_utc\": time.strftime(\"%Y-%m-%dT%H:%M:%SZ\", time.gmtime()),\n    }\n    p = OUT / \"W2_TEST_DENOMINATOR.json\"\n    p.write_text(json.dumps(doc, ensure_ascii=False, indent=1), encoding=\"utf-8\", newline=\"\\n\")\n    print(json.dumps({\"candidate\": head, \"w1_total\": w1_total, \"w2_total\": w2_total,\n                      \"grand_total\": doc[\"grand_total\"], \"w1_all_green\": doc[\"w1_regression\"][\"all_green\"],\n                      \"w2_all_green\": doc[\"w2_suites\"][\"all_green\"],\n                      \"zero_denominator_roots\": doc[\"zero_denominator_roots\"],\n                      \"aggregate_pass\": doc[\"aggregate_pass\"], \"sha256\": sha(p)}, indent=1))\n\n\nif __name__ == \"__main__\":\n    main()\n\r\n","exit_code":0,"status":"completed"}}
