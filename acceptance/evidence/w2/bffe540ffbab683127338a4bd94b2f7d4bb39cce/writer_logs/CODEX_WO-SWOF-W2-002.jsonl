n\",\n       \"null\"\n      ],\n      \"description\": \"The provider'\"'s own claim. True does NOT mean RECONCILED.\\\"\n     },\n     \\\"at\\\": {\n      \\\"type\\\": \\\"string\\\"\n     }\n    }\n   }\n  },\n  \\\"readbacks\\\": {\n   \\\"type\\\": \\\"array\\\",\n   \\\"items\\\": {\n    \\\"type\\\": \\\"object\\\",\n    \\\"additionalProperties\\\": false,\n    \\\"required\\\": [\n     \\\"payload\\\",\n     \\\"matches_expected\\\",\n     \\\"at\\\",\n     \\\"stale\\\"\n    ],\n    \\\"properties\\\": {\n     \\\"payload\\\": {},\n     \\\"matches_expected\\\": {\n      \\\"type\\\": [\n       \\\"boolean\\\",\n       \\\"null\\\"\n      ],\n      \\\"description\\\": \\\"null means ambiguous; anything but true fails closed.\\\"\n     },\n     \\\"at\\\": {\n      \\\"type\\\": \\\"string\\\"\n     },\n     \\\"stale\\\": {\n      \\\"type\\\": \\\"boolean\\\",\n      \\\"description\\\": \\\"A stale readback cannot reach RECONCILED.\\\"\n     }\n    }\n   }\n  },\n  \\\"provider_success\\\": {\n   \\\"type\\\": [\n    \\\"boolean\\\",\n    \\\"null\\\"\n   ]\n  },\n  \\\"reason_code\\\": {\n   \\\"type\\\": \\\"string\\\"\n  },\n  \\\"correlation_id\\\": {\n   \\\"type\\\": \\\"string\\\"\n  }\n }\n}\n'@\n[System.IO.File]::WriteAllText('C:\\\\Projects\\\\Agent_Workspace\\\\SWOF\\\\schemas\\\\effect\\\\effect_record.schema.json', (\"'$s -replace \"`r`n\",\"`n\") + \"`n\", $enc)\nWrite-Output \"wrote schema + README\"'","aggregated_output":"wrote schema + README\r\n","exit_code":0,"status":"completed"}}
