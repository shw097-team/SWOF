{"type":"item.completed","item":{"id":"item_63","type":"command_execution","command":"\"C:\\\\Users\\\\user\\\\AppData\\\\Local\\\\Microsoft\\\\WindowsApps\\\\pwsh.exe\" -Command '$i=0; Get-Content -LiteralPath \"src'\"\\\\effect\\\\state.py\\\" | ForEach-Object { \"'$i++; \"{0,4}: {1}\" -f $i, $_ }; Write-Output \"=== __init__.py ===\"; Get-Content -LiteralPath \"src'\"\\\\effect\\\\__init__.py\\\" -Raw\"","aggregated_output":"   1: \"\"\"Effect state machine: the closed alphabet of effect states and its legal transitions.\r\n   2: \r\n   3: WHY: an effect is not \"done\" because someone said so. Before any reconciliation machinery can\r\n   4: be trusted, the set of states must be finite and closed, and the legal edges between them must\r\n   5: be explicit. This module is that alphabet and those edges - nothing here executes anything or\r\n   6: touches the world. `OBSERVED -> RECONCILED` is deliberately NOT an edge: a provider response is\r\n   7: an OBSERVATION, and the only route to truth is a fresh readback (OBSERVED -> READBACK ->\r\n   8: RECONCILED). Unknown state names are refused rather than coerced, so a typo cannot silently\r\n   9: create a new state. Fail closed.\r\n  10: \"\"\"\r\n  11: from __future__ import annotations\r\n  12: \r\n  13: INTENT_STATES = (\"INTENDED\", \"ATTEMPTED\", \"OBSERVED\", \"READBACK\")\r\n  14: TERMINAL_STATES = (\"RECONCILED\", \"UNKNOWN_EFFECT\", \"PARTIAL_EFFECT\", \"DENIED\", \"FAILED\",\r\n  15:                    \"COMPENSATED\", \"IRREVERSIBLE\")\r\n  16: EFFECT_STATES = INTENT_STATES + TERMINAL_STATES\r\n  17: \r\n  18: UNKNOWN_STATES = (\"UNKNOWN_EFFECT\", \"PARTIAL_EFFECT\")\r\n  19: \r\n  20: \r\n  21: class EffectTransitionRefused(Exception):\r\n  22:     \"\"\"A transition, or a query over an unknown state, was refused (fail closed).\"\"\"\r\n  23: \r\n  24:     code = \"ERR_EFFECT_TRANSITION_REFUSED\"\r\n  25: \r\n  26: \r\n  27: # The single source of truth for legal edges.\r\n  28: # Intent chain: INTENDED -> ATTEMPTED -> OBSERVED -> READBACK.\r\n  29: # DENIED is reachable only from INTENDED (a refusal happens before any attempt).\r\n  30: # READBACK is the only state that may reach RECONCILED.\r\n  31: _ALLOWED = {\r\n  32:     \"INTENDED\": (\"ATTEMPTED\", \"DENIED\"),\r\n  33:     \"ATTEMPTED\": (\"OBSERVED\", \"FAILED\"),\r\n  34:     \"OBSERVED\": (\"READBACK\", \"FAILED\"),\r\n  35:     \"READBACK\": (\"RECONCILED\", \"UNKNOWN_EFFECT\", \"PARTIAL_EFFECT\"),\r\n  36:     \"RECONCILED\": (),\r\n  37:     \"UNKNOWN_EFFECT\": (),\r\n  38:     \"PARTIAL_EFFECT\": (\"COMPENSATED\",),\r\n  39:     \"DENIED\": (),\r\n  40:     \"FAILED\": (),\r\n  41:     \"COMPENSATED\": (),\r\n  42:     \"IRREVERSIBLE\": (),\r\n  43: }\r\n  44: \r\n  45: ALLOWED_TRANSITIONS = {state: frozenset(_ALLOWED[state]) for state in EFFECT_STATES}\r\n  46: \r\n  47: # Stable rank for deterministic ordering and for reporting a linearised state.\r\n  48: _STATE_RANK = {state: index for index, state in enumerate(EFFECT_STATES)}\r\n  49: \r\n  50: \r\n  51: def _check_state(state) -> str:\r\n  52:     if not isinstance(state, str) or state not in ALLOWED_TRANSITIONS:\r\n  53:         raise EffectTransitionRefused(\r\n  54:             \"unknown effect state %r; refusing to guess (fail closed)\" % (state,))\r\n  55:     return state\r\n  56: \r\n  57: \r\n  58: def is_terminal(state) -> bool:\r\n  59:     \"\"\"True for a terminal state. An unknown state is refused, never guessed.\"\"\"\r\n  60:     return _check_state(state) in TERMINAL_STATES\r\n  61: \r\n  62: \r\n  63: def is_unknown(state) -> bool:\r\n  64:     \"\"\"True for UNKNOWN_EFFECT and PARTIAL_EFFECT - uncertainty is first-class, not an error.\"\"\"\r\n  65:     return _check_state(state) in UNKNOWN_STATES\r\n  66: \r\n  67: \r\n  68: def assert_transition(src, dst) -> tuple[str, str]:\r\n  69:     \"\"\"Return (src, dst) when the edge is legal, else raise EffectTransitionRefused.\"\"\"\r\n  70:     source = _check_state(src)\r\n  71:     target = _check_state(dst)\r\n  72:     if target not in ALLOWED_TRANSITIONS[source]:\r\n  73:         raise EffectTransitionRefused(\r\n  74:             \"transition %s -> %s is not allowed (the only route to RECONCILED is \"\r\n  75:             \"OBSERVED -> READBACK -> RECONCILED)\" % (source, target))\r\n  76:     return source, target\r\n  77: \r\n  78: \r\n  79: def state_rank(state) -> int:\r\n  80:     \"\"\"Stable rank for deterministic ordering; unknown states are refused.\"\"\"\r\n  81:     return _STATE_RANK[_check_state(state)]\r\n=== __init__.py ===\r\n\"\"\"SWOF effect / observation / UNKNOWN_EFFECT / reconciliation substrate (W2, WO-SWOF-W2-002).\n\nA STATE MACHINE over immutable effect records, never an executor: nothing in this package\nperforms a network call, a subprocess, a filesystem effect or a broker/business action. A\nprovider response is an OBSERVATION, never world-state truth; only a fresh readback that matches\nthe intended effect may reach RECONCILED, and uncertainty is a first-class terminal state\n(UNKNOWN_EFFECT / PARTIAL_EFFECT). See README.md for the contract per module.\n\"\"\"\n\r\n","exit_code":0,"status":"completed"}}
