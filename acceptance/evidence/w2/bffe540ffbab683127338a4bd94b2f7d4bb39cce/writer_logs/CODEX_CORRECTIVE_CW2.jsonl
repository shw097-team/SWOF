atAssessment(unittest.TestCase):\r\n 227:     def test_assessment_states_detection_only(self):\r\n 228:         assessment = threat_assessment()\r\n 229:         self.assertEqual(assessment[\"schema\"], \"SWOF-W2-JOURNAL-INTEGRITY-ASSESSMENT/1\")\r\n 230:         self.assertTrue(assessment[\"implemented\"])\r\n 231:         self.assertEqual(assessment[\"protection_class\"], \"DETECTION_ONLY_NO_KEY_MANAGEMENT\")\r\n 232:         self.assertFalse(assessment[\"db_level_enforcement_claimed\"])\r\n 233:         self.assertFalse(assessment[\"writes_to_hgk\"])\r\n 234:         self.assertTrue(assessment[\"justified\"])\r\n 235: \r\n 236:     def test_assessment_states_non_claims_explicitly(self):\r\n 237:         text = \" \".join(threat_assessment()[\"does_not_give\"]).lower()\r\n 238:         self.assertIn(\"tamper-proof\", text)\r\n 239:         self.assertIn(\"not a cryptographic signature\", text)\r\n 240:         self.assertIn(\"read-only\", text)\r\n 241:         self.assertIn(\"w1 subject\", text)\r\n 242: \r\n 243: \r\n 244: if __name__ == \"__main__\":\r\n 245:     unittest.main()\r\n","exit_code":0,"status":"completed"}}
