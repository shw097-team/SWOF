{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"\"C:\\\\Users\\\\user\\\\AppData\\\\Local\\\\Microsoft\\\\WindowsApps\\\\pwsh.exe\" -Command '$i=0; Get-Content -LiteralPath \"src'\"\\\\assurance\\\\journal.py\\\" | ForEach-Object { \"'$i++; if ($i -le 200) { \"{0,4}: {1}\" -f $i, $_ } }'","aggregated_output":"   1: \"\"\"Journal-integrity envelope: a DETECTION-ONLY digest chain over an EXPORTED event stream.\r\n   2: \r\n   3: W2-JOURNAL-INTEGRITY-ASSESSMENT. This module verifies a stream of lifecycle events that has\r\n   4: been exported OUT of HG-KSEOS. It never writes to, reads transactional locks in, or claims\r\n   5: cryptographic protection of the HGK database. It is explicitly NOT a signature: there is no\r\n   6: key management, so it cannot prove authorship - only that an exported stream was not modified\r\n   7: after the manifest was produced.\r\n   8: \r\n   9: Each entry's digest binds the chain identity:\r\n  10: \r\n  11:     entry_digest = sha256(chain_id | seq | event_id | prev_digest | canonical_json(payload))\r\n  12: \r\n  13: so an entry lifted from another chain cannot be spliced in (`CHAIN_ID_MISMATCH`), a mutated\r\n  14: payload shows as `ENTRY_DIGEST_MISMATCH`, a removed/truncated entry as `SEQ_GAP`, a reordered\r\n  15: entry as `PREV_DIGEST_MISMATCH` (the `prev_digest` linkage is checked independently of `seq`),\r\n  16: and a tampered header as `HEADER_MISMATCH`.\r\n  17: \r\n  18: The chain genesis is chain-bound (sha256 over the chain id), which is what makes a foreign\r\n  19: splice distinguishable from an in-chain payload edit: a foreign seq-1 entry carries a foreign\r\n  20: genesis and fails as CHAIN_ID_MISMATCH before any digest is recomputed.\r\n  21: \"\"\"\r\n  22: from __future__ import annotations\r\n  23: \r\n  24: import hashlib\r\n  25: import json\r\n  26: from dataclasses import dataclass\r\n  27: \r\n  28: GENESIS_DOMAIN = \"swof.journal.genesis.v1\"\r\n  29: \r\n  30: MANIFEST_SCHEMA = \"SWOF-JOURNAL-MANIFEST/1\"\r\n  31: VERDICT_SCHEMA = \"SWOF-JOURNAL-VERDICT/1\"\r\n  32: THREAT_SCHEMA = \"SWOF-W2-JOURNAL-INTEGRITY-ASSESSMENT/1\"\r\n  33: \r\n  34: \r\n  35: class JournalTamperDetected(Exception):\r\n  36:     \"\"\"A tamper class was detected while verifying an exported chain.\"\"\"\r\n  37: \r\n  38:     code = \"ERR_JOURNAL_TAMPER_DETECTED\"\r\n  39: \r\n  40:     def __init__(self, message, reason_code, first_broken_seq=None):\r\n  41:         super().__init__(message)\r\n  42:         self.reason_code = reason_code\r\n  43:         self.first_broken_seq = first_broken_seq\r\n  44: \r\n  45: \r\n  46: @dataclass(frozen=True)\r\n  47: class JournalEntry:\r\n  48:     seq: int\r\n  49:     event_id: str\r\n  50:     payload: dict\r\n  51:     prev_digest: str\r\n  52:     entry_digest: str\r\n  53: \r\n  54: \r\n  55: def chain_genesis(chain_id):\r\n  56:     \"\"\"The default genesis digest, bound to the chain id (a foreign chain differs here).\"\"\"\r\n  57:     return hashlib.sha256((GENESIS_DOMAIN + \"\\x00\" + str(chain_id)).encode(\"utf-8\")).hexdigest()\r\n  58: \r\n  59: \r\n  60: def _canonical_payload(payload):\r\n  61:     return json.dumps(payload, sort_keys=True, separators=(\",\", \":\"), ensure_ascii=True)\r\n  62: \r\n  63: \r\n  64: def _compute_digest(chain_id, seq, event_id, prev_digest, payload):\r\n  65:     material = \"\\x00\".join([\r\n  66:         str(chain_id),\r\n  67:         str(seq),\r\n  68:         str(event_id),\r\n  69:         str(prev_digest),\r\n  70:         _canonical_payload(payload),\r\n  71:     ])\r\n  72:     return hashlib.sha256(material.encode(\"utf-8\")).hexdigest()\r\n  73: \r\n  74: \r\n  75: def _verdict(intact, checked, reason_code, first_broken_seq):\r\n  76:     return {\r\n  77:         \"schema\": VERDICT_SCHEMA,\r\n  78:         \"intact\": intact,\r\n  79:         \"checked\": checked,\r\n  80:         \"reason_code\": reason_code,\r\n  81:         \"first_broken_seq\": first_broken_seq,\r\n  82:     }\r\n  83: \r\n  84: \r\n  85: class DigestChainJournal:\r\n  86:     \"\"\"An append-only digest chain bound to `chain_id`; verify-only over exports.\"\"\"\r\n  87: \r\n  88:     def __init__(self, chain_id, *, genesis_digest=None):\r\n  89:         if not chain_id:\r\n  90:             raise ValueError(\"chain_id must be non-empty\")\r\n  91:         self.chain_id = chain_id\r\n  92:         self.genesis_digest = (chain_genesis(chain_id) if genesis_digest is None\r\n  93:                                else genesis_digest)\r\n  94:         self.entries = []\r\n  95:         self.header = {\r\n  96:             \"chain_id\": self.chain_id,\r\n  97:             \"genesis_digest\": self.genesis_digest,\r\n  98:             \"entry_count\": 0,\r\n  99:             \"final_digest\": self.genesis_digest,\r\n 100:         }\r\n 101:         self._final_digest = self.genesis_digest\r\n 102: \r\n 103:     def append(self, *, event_id, payload):\r\n 104:         seq = len(self.entries) + 1\r\n 105:         prev_digest = self._final_digest\r\n 106:         entry_digest = _compute_digest(self.chain_id, seq, event_id, prev_digest, payload)\r\n 107:         entry = JournalEntry(\r\n 108:             seq=seq,\r\n 109:             event_id=event_id,\r\n 110:             payload=payload,\r\n 111:             prev_digest=prev_digest,\r\n 112:             entry_digest=entry_digest,\r\n 113:         )\r\n 114:         self.entries.append(entry)\r\n 115:         self._final_digest = entry_digest\r\n 116:         self.header[\"entry_count\"] = len(self.entries)\r\n 117:         self.header[\"final_digest\"] = entry_digest\r\n 118:         return entry\r\n 119: \r\n 120:     def _is_deletion_not_reorder(self):\r\n 121:         \"\"\"True when the surviving seq numbers are strictly increasing but fall short of the\r\n 122:         header's declared count - i.e. entries were removed rather than reordered.\r\n 123: \r\n 124:         A deletion or truncation leaves strictly increasing, unique seq numbers (a subsequence\r\n 125:         of the range); a naive swap leaves the full multiset of seq numbers but out of order.\r\n 126:         That difference is what separates SEQ_GAP from PREV_DIGEST_MISMATCH.\r\n 127:         \"\"\"\r\n 128:         seqs = [entry.seq for entry in self.entries]\r\n 129:         if not seqs:\r\n 130:             return True\r\n 131:         if len(set(seqs)) != len(seqs):\r\n 132:             return False\r\n 133:         if any(seqs[index] >= seqs[index + 1] for index in range(len(seqs) - 1)):\r\n 134:             return False\r\n 135:         declared = self.header.get(\"entry_count\")\r\n 136:         if declared is None:\r\n 137:             return True\r\n 138:         return len(seqs) < declared\r\n 139: \r\n 140:     def verify(self):\r\n 141:         \"\"\"Detect tampering in the current (possibly modified) entry list; raise on break.\r\n 142: \r\n 143:         Each tamper class maps to its own reason: a mutated payload to ENTRY_DIGEST_MISMATCH, a\r\n 144:         removed or truncated entry to SEQ_GAP, a reordered entry to PREV_DIGEST_MISMATCH, a\r\n 145:         foreign chain splice to CHAIN_ID_MISMATCH and a tampered header to HEADER_MISMATCH. The\r\n 146:         `prev_digest` linkage is checked independently of `seq`, so a swap that leaves the seq\r\n 147:         numbers a permutation of the range is still caught as a linkage break.\r\n 148:         \"\"\"\r\n 149:         prev_digest = self.genesis_digest\r\n 150:         deleted = self._is_deletion_not_reorder()\r\n 151: \r\n 152:         for index, entry in enumerate(self.entries):\r\n 153:             expected_seq = index + 1\r\n 154:             if entry.seq != expected_seq:\r\n 155:                 if deleted:\r\n 156:                     self._fail(\"SEQ_GAP\", expected_seq,\r\n 157:                                \"expected seq %d, found %d (entry removed or stream \"\r\n 158:                                \"truncated)\" % (expected_seq, entry.seq))\r\n 159:                 self._fail(\"PREV_DIGEST_MISMATCH\", entry.seq,\r\n 160:                            \"entry seq %d is out of order at position %d (entries reordered)\"\r\n 161:                            % (entry.seq, expected_seq))\r\n 162: \r\n 163:             if entry.prev_digest != prev_digest:\r\n 164:                 if index == 0:\r\n 165:                     self._fail(\"CHAIN_ID_MISMATCH\", entry.seq,\r\n 166:                                \"seq 1 prev_digest %r is not this chain's genesis %r \"\r\n 167:                                \"(foreign chain splice)\" % (entry.prev_digest,\r\n 168:                                                            self.genesis_digest))\r\n 169:                 self._fail(\"PREV_DIGEST_MISMATCH\", entry.seq,\r\n 170:                            \"entry seq %d prev_digest %r != %r (reordered or spliced entry)\"\r\n 171:                            % (entry.seq, entry.prev_digest, prev_digest))\r\n 172: \r\n 173:             recomputed = _compute_digest(self.chain_id, entry.seq, entry.event_id,\r\n 174:                                          entry.prev_digest, entry.payload)\r\n 175:             if recomputed != entry.entry_digest:\r\n 176:                 self._fail(\"ENTRY_DIGEST_MISMATCH\", entry.seq,\r\n 177:                            \"entry seq %d digest %r != recomputed %r (payload or header \"\r\n 178:                            \"mutation)\" % (entry.seq, entry.entry_digest, recomputed))\r\n 179: \r\n 180:             prev_digest = entry.entry_digest\r\n 181: \r\n 182:         declared_count = self.header.get(\"entry_count\")\r\n 183:         if declared_count is not None and len(self.entries) < declared_count:\r\n 184:             self._fail(\"SEQ_GAP\", len(self.entries) + 1,\r\n 185:                        \"header declares %d entries but only %d are present \"\r\n 186:                        \"(entry removed or stream truncated)\"\r\n 187:                        % (declared_count, len(self.entries)))\r\n 188: \r\n 189:         if declared_count is not None and len(self.entries) > declared_count:\r\n 190:             self._fail(\"HEADER_MISMATCH\", declared_count + 1,\r\n 191:                        \"header declares only %d entries but %d are present \"\r\n 192:                        \"(header tampered or entries appended)\" % (declared_count,\r\n 193:                                                                   len(self.entries)))\r\n 194: \r\n 195:         if self.header.get(\"final_digest\", prev_digest) != prev_digest:\r\n 196:             self._fail(\"HEADER_MISMATCH\", len(self.entries),\r\n 197:                        \"header final_digest %r != chain final digest %r (header tampering)\"\r\n 198:                        % (self.header.get(\"final_digest\"), prev_digest))\r\n 199: \r\n 200:         return _verdict(True, len(self.entries), \"INTACT\", None)\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"\"C:\\\\Users\\\\user\\\\AppData\\\\Local\\\\Microsoft\\\\WindowsApps\\\\pwsh.exe\" -Command '$i=0; Get-Content -LiteralPath \"src'\"\\\\assurance\\\\predicate.py\\\" | ForEach-Object { \"'$i++; \"{0,4}: {1}\" -f $i, $_ }'","aggregated_output":"   1: \"\"\"Acceptance predicates: the decidable, falsifiable unit of SWOF assurance.\r\n   2: \r\n   3: A predicate is the *only* place a PASS/FAIL question is defined. The law this module\r\n   4: enforces is one line:\r\n   5: \r\n   6:     a predicate that cannot fail is not a predicate.\r\n   7: \r\n   8: So an empty oracle, an empty evidence requirement, an empty negative-fixture set, an\r\n   9: unknown subject type or a terminal-state set with fewer than two members are all refused\r\n  10: with a typed `PredicateInvalid` carrying a specific `reason_code`, and validation happens\r\n  11: on the RAW input *before* anything is constructed, so malformed input never leaks a\r\n  12: generic `TypeError`.\r\n  13: \r\n  14: `digest` covers immutable semantic content only. Runtime binding state (the plan, the\r\n  15: environment, the run) is deliberately excluded, so two predicates that differ only in a\r\n  16: runtime field cannot collide and the same predicate always digests the same.\r\n  17: \"\"\"\r\n  18: from __future__ import annotations\r\n  19: \r\n  20: import hashlib\r\n  21: import json\r\n  22: from dataclasses import dataclass\r\n  23: \r\n  24: SUBJECT_TYPES = (\"DELIVERABLE\", \"CAPABILITY\", \"JOURNEY\", \"REQUIREMENT\")\r\n  25: \r\n  26: DIGEST_DOMAIN = \"swof.assurance.predicate.v1\"\r\n  27: \r\n  28: # The immutable semantic fields, in a documented, stable order. Runtime binding fields are\r\n  29: # NOT here: a predicate digest describes meaning, not the run in which it is checked.\r\n  30: _SEMANTIC_FIELDS = (\r\n  31:     \"predicate_id\",\r\n  32:     \"subject_id\",\r\n  33:     \"subject_type\",\r\n  34:     \"required_evidence_kinds\",\r\n  35:     \"oracle_id\",\r\n  36:     \"terminal_states\",\r\n  37:     \"negative_fixtures\",\r\n  38:     \"raw_evidence_required\",\r\n  39:     \"independent_checker_required\",\r\n  40: )\r\n  41: \r\n  42: \r\n  43: class PredicateInvalid(Exception):\r\n  44:     \"\"\"A predicate that cannot fail (or is malformed) was refused.\"\"\"\r\n  45: \r\n  46:     code = \"ERR_PREDICATE_INVALID\"\r\n  47: \r\n  48:     def __init__(self, message, reason_code=\"PREDICATE_INVALID\"):\r\n  49:         super().__init__(message)\r\n  50:         self.reason_code = reason_code\r\n  51: \r\n  52: \r\n  53: @dataclass(frozen=True)\r\n  54: class AcceptancePredicate:\r\n  55:     predicate_id: str\r\n  56:     subject_id: str\r\n  57:     subject_type: str\r\n  58:     required_evidence_kinds: frozenset\r\n  59:     oracle_id: str\r\n  60:     terminal_states: tuple\r\n  61:     negative_fixtures: tuple\r\n  62:     raw_evidence_required: bool = True\r\n  63:     independent_checker_required: bool = True\r\n  64: \r\n  65: \r\n  66: def _field(raw, name, default=None):\r\n  67:     if isinstance(raw, dict):\r\n  68:         return raw.get(name, default)\r\n  69:     return getattr(raw, name, default)\r\n  70: \r\n  71: \r\n  72: def _is_nonempty_str(value):\r\n  73:     return isinstance(value, str) and value.strip() != \"\"\r\n  74: \r\n  75: \r\n  76: def _validate_raw(raw):\r\n  77:     if raw is None:\r\n  78:         raise PredicateInvalid(\"predicate is None\", \"PREDICATE_NONE\")\r\n  79: \r\n  80:     for name in (\"predicate_id\", \"subject_id\", \"oracle_id\"):\r\n  81:         if not _is_nonempty_str(_field(raw, name)):\r\n  82:             raise PredicateInvalid(\r\n  83:                 \"%s must be a non-empty string\" % name, \"MISSING_\" + name.upper())\r\n  84: \r\n  85:     subject_type = _field(raw, \"subject_type\")\r\n  86:     if subject_type not in SUBJECT_TYPES:\r\n  87:         raise PredicateInvalid(\r\n  88:             \"unknown subject_type %r (known: %s)\" % (subject_type, \", \".join(SUBJECT_TYPES)),\r\n  89:             \"UNKNOWN_SUBJECT_TYPE\")\r\n  90: \r\n  91:     kinds = _field(raw, \"required_evidence_kinds\")\r\n  92:     if kinds is None or not isinstance(kinds, (frozenset, set, tuple, list)):\r\n  93:         raise PredicateInvalid(\r\n  94:             \"required_evidence_kinds must be a collection, got %r\" % (type(kinds).__name__,),\r\n  95:             \"REQUIRED_EVIDENCE_KINDS_NOT_A_COLLECTION\")\r\n  96:     if len(kinds) == 0:\r\n  97:         raise PredicateInvalid(\r\n  98:             \"required_evidence_kinds is empty: a predicate with no required evidence \"\r\n  99:             \"cannot fail\", \"EMPTY_REQUIRED_EVIDENCE_KINDS\")\r\n 100:     for kind in kinds:\r\n 101:         if not _is_nonempty_str(kind):\r\n 102:             raise PredicateInvalid(\r\n 103:                 \"required_evidence_kinds contains a non-string/empty entry %r\" % (kind,),\r\n 104:                 \"MALFORMED_REQUIRED_EVIDENCE_KIND\")\r\n 105: \r\n 106:     terminal_states = _field(raw, \"terminal_states\")\r\n 107:     if terminal_states is None or not isinstance(terminal_states, (tuple, list)):\r\n 108:         raise PredicateInvalid(\r\n 109:             \"terminal_states must be a sequence, got %r\" % (type(terminal_states).__name__,),\r\n 110:             \"TERMINAL_STATES_NOT_A_SEQUENCE\")\r\n 111:     if len(terminal_states) < 2:\r\n 112:         raise PredicateInvalid(\r\n 113:             \"terminal_states has %d state(s): fewer than two terminal states cannot \"\r\n 114:             \"express failure\" % len(terminal_states), \"TOO_FEW_TERMINAL_STATES\")\r\n 115:     for state in terminal_states:\r\n 116:         if not _is_nonempty_str(state):\r\n 117:             raise PredicateInvalid(\r\n 118:                 \"terminal_states contains a non-string/empty entry %r\" % (state,),\r\n 119:                 \"MALFORMED_TERMINAL_STATE\")\r\n 120: \r\n 121:     negative_fixtures = _field(raw, \"negative_fixtures\")\r\n 122:     if negative_fixtures is None or not isinstance(negative_fixtures, (tuple, list)):\r\n 123:         raise PredicateInvalid(\r\n 124:             \"negative_fixtures must be a sequence, got %r\"\r\n 125:             % (type(negative_fixtures).__name__,), \"NEGATIVE_FIXTURES_NOT_A_SEQUENCE\")\r\n 126:     if len(negative_fixtures) == 0:\r\n 127:         raise PredicateInvalid(\r\n 128:             \"negative_fixtures is empty: a predicate whose negatives are never tested is \"\r\n 129:             \"not decidable\", \"EMPTY_NEGATIVE_FIXTURES\")\r\n 130:     for fixture in negative_fixtures:\r\n 131:         if not _is_nonempty_str(fixture):\r\n 132:             raise PredicateInvalid(\r\n 133:                 \"negative_fixtures contains a non-string/empty entry %r\" % (fixture,),\r\n 134:                 \"MALFORMED_NEGATIVE_FIXTURE\")\r\n 135: \r\n 136:     for name in (\"raw_evidence_required\", \"independent_checker_required\"):\r\n 137:         value = _field(raw, name, None)\r\n 138:         if value is not None and not isinstance(value, bool):\r\n 139:             raise PredicateInvalid(\r\n 140:                 \"%s must be a bool when present, got %r\" % (name, value),\r\n 141:                 \"MALFORMED_FLAG_\" + name.upper())\r\n 142: \r\n 143: \r\n 144: def validate(predicate):\r\n 145:     \"\"\"Validate the RAW input and return an immutable AcceptancePredicate.\r\n 146: \r\n 147:     The raw mapping/object is validated first, so a malformed input raises\r\n 148:     PredicateInvalid rather than a generic TypeError from constructing a dataclass.\r\n 149:     \"\"\"\r\n 150:     _validate_raw(predicate)\r\n 151: \r\n 152:     def _get(name, default=None):\r\n 153:         return _field(predicate, name, default)\r\n 154: \r\n 155:     return AcceptancePredicate(\r\n 156:         predicate_id=_get(\"predicate_id\"),\r\n 157:         subject_id=_get(\"subject_id\"),\r\n 158:         subject_type=_get(\"subject_type\"),\r\n 159:         required_evidence_kinds=frozenset(_get(\"required_evidence_kinds\")),\r\n 160:         oracle_id=_get(\"oracle_id\"),\r\n 161:         terminal_states=tuple(_get(\"terminal_states\")),\r\n 162:         negative_fixtures=tuple(_get(\"negative_fixtures\")),\r\n 163:         raw_evidence_required=bool(_get(\"raw_evidence_required\", True)),\r\n 164:         independent_checker_required=bool(_get(\"independent_checker_required\", True)),\r\n 165:     )\r\n 166: \r\n 167: \r\n 168: def _canonical_bytes(predicate):\r\n 169:     raw = predicate if isinstance(predicate, dict) else None\r\n 170:     if raw is None:\r\n 171:         raw = {name: getattr(predicate, name) for name in _SEMANTIC_FIELDS}\r\n 172:     else:\r\n 173:         missing = [name for name in _SEMANTIC_FIELDS if name not in raw]\r\n 174:         if missing:\r\n 175:             raise PredicateInvalid(\r\n 176:                 \"predicate mapping is missing semantic fields %s\" % (missing,),\r\n 177:                 \"MISSING_SEMANTIC_FIELDS\")\r\n 178:     material = {name: raw[name] for name in _SEMANTIC_FIELDS}\r\n 179:     material[\"required_evidence_kinds\"] = sorted(material[\"required_evidence_kinds\"])\r\n 180:     material[\"terminal_states\"] = list(material[\"terminal_states\"])\r\n 181:     material[\"negative_fixtures\"] = list(material[\"negative_fixtures\"])\r\n 182:     canon = json.dumps(material, sort_keys=True, separators=(\",\", \":\"), ensure_ascii=True)\r\n 183:     return canon.encode(\"utf-8\")\r\n 184: \r\n 185: \r\n 186: def digest(predicate):\r\n 187:     \"\"\"Deterministic sha256 hex over the immutable semantic content of the predicate.\r\n 188: \r\n 189:     Accepts an AcceptancePredicate or a validated mapping. Runtime binding state is\r\n 190:     excluded by construction, so it can never influence (or collide with) this digest.\r\n 191:     \"\"\"\r\n 192:     if not isinstance(predicate, AcceptancePredicate):\r\n 193:         predicate = validate(predicate)\r\n 194:     payload = DIGEST_DOMAIN.encode(\"utf-8\") + b\"\\x00\" + _canonical_bytes(predicate)\r\n 195:     return hashlib.sha256(payload).hexdigest()\r\n","exit_code":0,"status":"completed"}}
