id, record.subject_id, record.intent_digest, attempt_no)\r\n  35: \r\n  36: \r\n  37: def observed(provider_success=True):\r\n  38:     return observe(attempted(), payload={\"status\": \"ok\"}, provider_success=provider_success,\r\n  39:                    at=\"2026-10-03T00:00:01Z\")\r\n  40: \r\n  41: \r\n  42: class TestIntent(unittest.TestCase):\r\n  43:     def test_intend_freezes_digest_and_state(self):\r\n  44:         record = intended()\r\n  45:         self.assertEqual(record.state, \"INTENDED\")\r\n  46:         self.assertTrue(record.intent_digest)\r\n  47:         self.assertEqual(record.environment, \"test\")\r\n  48: \r\n  49:     def test_intent_digest_ignores_later_mutation(self):\r\n  50:         record = observed()\r\n  51:         fresh = intended()\r\n  52:         self.assertEqual(record.intent_digest, fresh.intent_digest)\r\n  53:         self.assertNotEqual(record.intent_digest,\r\n  54:                             intended(effect_id=\"eff-2\").intent_digest)\r\n  55: \r\n  56:     def test_intent_digest_changes_with_any_input(self):\r\n  57:         base = intended()\r\n  58:         self.assertNotEqual(base.intent_digest, intended(subject_id=\"subj-2\").intent_digest)\r\n  59:         self.assertNotEqual(base.intent_digest,\r\n  60:                             intended(intent={\"op\": \"update\"}).intent_digest)\r\n=== compensation.py ===\r\n   1: \"\"\"Compensation: classify reversibility and PLAN a compensation path. Never execute one.\r\n   2: \r\n   3: WHY: an effect that cannot be undone must say so, loudly, before anyone tries to \"clean up\".\r\n   4: An effect with a declared irreversible attempt classifies as IRREVERSIBLE and yields a pointer\r\n   5: that is explicitly not compensable. A PARTIAL_EFFECT with a registered path yields a\r\n   6: COMPENSATE/ROLLBACK pointer carrying an exact ref; with no registered path it is refused with\r\n   7: NoCompensationPath rather than silently passed. Planning is all that happens here - no rollback\r\n   8: is ever executed by this module.\r\n   9: \"\"\"\r\n  10: from __future__ import annotations\r\n  11: \r\n  12: from dataclasses import dataclass\r\n  13: \r\n  14: from effect.state import is_unknown\r\n  15: \r\n  16: COMPENSABLE_KINDS = (\"COMPENSATE\", \"ROLLBACK\")\r\n  17: \r\n  18: IRREVERSIBLE_REASON = \"IRREVERSIBLE_EFFECT\"\r\n  19: NO_PATH_REASON = \"NO_COMPENSATION_PATH\"\r\n  20: \r\n  21: \r\n  22: class IrreversibleEffect(Exception):\r\n  23:     \"\"\"The effect (or one of its attempts) cannot be undone; compensation is impossible.\"\"\"\r\n  24: \r\n  25:     code = \"ERR_IRREVERSIBLE_EFFECT\"\r\n  26: \r\n  27: \r\n  28: class NoCompensationPath(Exception):\r\n  29:     \"\"\"No compensation path is registered for this effect; explicit refusal, not a silent pass.\"\"\"\r\n  30: \r\n  31:     code = \"ERR_NO_COMPENSATION_PATH\"\r\n  32: \r\n  33: \r\n  34: @dataclass(frozen=True)\r\n  35: class CompensationPointer:\r\n  36:     \"\"\"A pointer at a planned (never executed) compensation. `ref` is the exact target.\"\"\"\r\n  37: \r\n  38:     target_effect_id: str\r\n  39:     ref: str\r\n  40:     kind: str\r\n  41:     compensable: bool\r\n  42:     reason_code: str\r\n  43: \r\n  44: \r\n  45: def _has_irreversible(record, irreversible_attempts) -> bool:\r\n  46:     declared = set(irreversible_attempts or ())\r\n  47:     if not declared:\r\n  48:         return False\r\n  49:     keys = {attempt.attempt_key for attempt in record.attempts}\r\n  50:     if keys & declared:\r\n  51:         return True\r\n  52:     # A caller may declare an attempt number/identity that has not been recorded yet.\r\n  53:     if record.effect_id in declared:\r\n  54:         return True\r\n  55:     return False\r\n  56: \r\n  57: \r\n  58: def classify(record, *, irreversible_attempts=()) -> str:\r\n  59:     \"\"\"Classify the effect as IRREVERSIBLE when any declared attempt is irreversible.\"\"\"\r\n  60:     if _has_irreversible(record, irreversible_attempts):\r\n  61:         return \"IRREVERSIBLE\"\r\n  62:     return record.state\r\n  63: \r\n  64: \r\n  65: def _registry_ref(registry, record):\r\n  66:     if registry is None:\r\n  67:         return None\r\n  68:     if isinstance(registry, dict):\r\n  69:         return registry.get(record.effect_id) or registry.get(record.subject_id)\r\n  70:     return None\r\n  71: \r\n  72: \r\n  73: def plan_compensation(record, *, registry=None, irreversible_attempts=()) -> CompensationPointer:\r\n  74:     \"\"\"Plan compensation, or raise. There is no execution path here.\"\"\"\r\n  75:     if classify(record, irreversible_attempts=irreversible_attempts) == \"IRREVERSIBLE\":\r\n  76:         return CompensationPointer(\r\n  77:             target_effect_id=record.effect_id, ref=\"\", kind=\"NONE\", compensable=False,\r\n  78:             reason_code=IRREVERSIBLE_REASON)\r\n  79:     if record.state != \"PARTIAL_EFFECT\" and not is_unknown(record.state):\r\n  80:         return CompensationPointer(\r\n  81:             target_effect_id=record.effect_id, ref=\"\", kind=\"NONE\", compensable=False,\r\n  82:             reason_code=\"NOT_COMPENSABLE_STATE\")\r\n  83:     if record.state != \"PARTIAL_EFFECT\":\r\n  84:         return CompensationPointer(\r\n  85:             target_effect_id=record.effect_id, ref=\"\", kind=\"NONE\", compensable=False,\r\n  86:             reason_code=\"NOT_PARTIAL_EFFECT\")\r\n  87:     ref = _registry_ref(registry, record)\r\n  88:     if ref is None:\r\n  89:         raise NoCompensationPath(\r\n  90:             \"no compensation path registered for partial effect %r\" % record.effect_id)\r\n  91:     kind = ref.get(\"kind\") if isinstance(ref, dict) else None\r\n  92:     target = ref.get(\"ref\") if isinstance(ref, dict) else None\r\n  93:     if kind not in COMPENSABLE_KINDS or not target:\r\n  94:         raise NoCompensationPath(\r\n  95:             \"registered compensation ref for %r is not a COMPENSATE/ROLLBACK pointer with an \"\r\n  96:             \"exact ref\" % record.effect_id)\r\n  97:     return CompensationPointer(\r\n  98:         target_effect_id=record.effect_id, ref=target, kind=kind, compensable=True,\r\n  99:         reason_code=\"COMPENSATION_PLANNED\")\r\n 100: \r\n 101: \r\n 102: def assert_compensable(pointer) -> CompensationPointer:\r\n 103:     \"\"\"Return the pointer when it is compensable, else raise IrreversibleEffect.\"\"\"\r\n 104:     if not isinstance(pointer, CompensationPointer):\r\n 105:         raise IrreversibleEffect(\"not a CompensationPointer; refusing (fail closed)\")\r\n 106:     if not pointer.compensable:\r\n 107:         if pointer.reason_code == IRREVERSIBLE_REASON:\r\n 108:             raise IrreversibleEffect(\r\n 109:                 \"effect %r is irreversible; no compensation is possible\"\r\n 110:                 % pointer.target_effect_id)\r\n 111:         raise NoCompensationPath(\r\n 112:             \"effect %r has no compensable path (%s)\"\r\n 113:             % (pointer.target_effect_id, pointer.reason_code))\r\n 114:     return pointer\r\n","exit_code":0,"status":"completed"}}
