\n 169:         for sample in PLANTED_SHAPES:\r\n 170:             self.assertIn(\"[REDACTED:SECRET]\", redact(sample), sample)\r\n 171: \r\n 172:     def test_every_planted_shape_is_blocked_by_the_gate(self):\r\n 173:         for sample in PLANTED_SHAPES:\r\n 174:             with self.assertRaises(SecretExfiltrationBlocked):\r\n 175:                 assert_no_secret({\"evidence\": sample})\r\n 176: \r\n 177:     def test_bearer_header_shape(self):\r\n 178:         self.assertEqual(classify(BEARER), \"SECRET\")\r\n 179:         self.assertNotIn(\"eyJhbGciOiJIUzI1NiJ9\", redact(BEARER))\r\n 180: \r\n 181:     def test_aws_secret_access_key_assignment(self):\r\n 182:         self.assertEqual(classify(AWS_SECRET), \"SECRET\")\r\n 183:         self.assertNotIn(\"wJalrXUtnFEMI\", redact(AWS_SECRET))\r\n 184: \r\n 185:     def test_vendor_prefixed_tokens(self):\r\n 186:         for sample in (GITHUB_PAT, GITLAB_PAT, SLACK_TOKEN, STRIPE_KEY):\r\n 187:             self.assertEqual(classify(sample), \"SECRET\", sample)\r\n 188:             self.assertEqual(redact(sample), \"[REDACTED:SECRET]\", sample)\r\n 189: \r\n 190:     def test_aws_session_key_shape(self):\r\n 191:         self.assertEqual(classify(AWS_SESSION_KEY), \"SECRET\")\r\n 192:         self.assertEqual(redact(\"id \" + AWS_SESSION_KEY), \"id [REDACTED:SECRET]\")\r\n 193: \r\n 194:     def test_ssh_public_key_blob(self):\r\n 195:         self.assertEqual(classify(SSH_BLOB), \"SECRET\")\r\n 196:         self.assertNotIn(\"AAAAB3NzaC1yc2E\", redact(SSH_BLOB))\r\n 197: \r\n 198:     def test_json_key_value_pair_is_caught(self):\r\n 199:         for sample in (JSON_ACCESS, JSON_TOKEN, JSON_API_KEY):\r\n 200:             self.assertEqual(classify(sample), \"SECRET\", sample)\r\n 201:             self.assertNotIn(\"eyJhbGciOiJIUzI1NiJ9\", redact(sample))\r\n 202: \r\n 203:     def test_json_mapping_value_is_redacted_and_blocked(self):\r\n 204:         payload = {\"access_token\": \"eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIxI