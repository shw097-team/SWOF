{"type":"item.completed","item":{"id":"item_48","type":"command_execution","command":"\"C:\\\\Users\\\\user\\\\AppData\\\\Local\\\\Microsoft\\\\WindowsApps\\\\pwsh.exe\" -Command '$i=0; Get-Content -LiteralPath \"src'\"\\\\effect\\\\tests\\\\test_idempotency.py\\\" | ForEach-Object { \"'$i++; \"{0,4}: {1}\" -f $i, $_ }; Write-Output \"########## ADVERSARIAL\"; $i=0; Get-Content -LiteralPath \"src'\"\\\\effect\\\\tests\\\\test_adversarial.py\\\" | ForEach-Object { \"'$i++; \"{0,4}: {1}\" -f $i, $_ }'","aggregated_output":"   1: \"\"\"Focused tests: attempt-key identity, duplicate refusal, retry ceiling, reobserve-not-retry.\"\"\"\r\n   2: import sys\r\n   3: import unittest\r\n   4: from pathlib import Path\r\n   5: \r\n   6: ROOT = Path(__file__).resolve().parents[3]\r\n   7: sys.path.insert(0, str(ROOT / \"src\"))\r\n   8: \r\n   9: from effect.idempotency import (  # noqa: E402\r\n  10:     DuplicateAttemptDetected, RetryPlan, RetryRefused, assert_retryable, attempt_key,\r\n  11:     classify_retry, plan_reobserve, plan_retry,\r\n  12: )\r\n  13: from effect.substrate import intend, observe, readback, reconcile, record_attempt  # noqa: E402\r\n  14: \r\n  15: \r\n  16: def new_intent():\r\n  17:     return intend(\"eff-1\", \"subj-1\", {\"op\": \"create\"})\r\n  18: \r\n  19: \r\n  20: def key_for(record, attempt_no):\r\n  21:     return attempt_key(record.effect_id, record.subject_id, record.intent_digest, attempt_no)\r\n  22: \r\n  23: \r\n  24: def attempted():\r\n  25:     record = new_intent()\r\n  26:     return record_attempt(record, actor=\"agent-7\", permission_allowed=True,\r\n  27:                           attempt_key=key_for(record, 1), at=\"t0\")\r\n  28: \r\n  29: \r\n  30: def as_state(record, state, reason_code=\"\"):\r\n  31:     return record.__class__(**{**record.__dict__, \"state\": state, \"reason_code\": reason_code})\r\n  32: \r\n  33: \r\n  34: class TestAttemptKey(unittest.TestCase):\r\n  35:     def test_key_is_deterministic(self):\r\n  36:         first = attempt_key(\"eff-1\", \"subj-1\", \"digest\", 1)\r\n  37:         self.assertEqual(first, attempt_key(\"eff-1\", \"subj-1\", \"digest\", 1))\r\n  38:         self.assertEqual(len(first), 64)\r\n  39:         int(first, 16)\r\n  40: \r\n  41:     def test_key_depends_on_every_input(self):\r\n  42:         base = attempt_key(\"eff-1\", \"subj-1\", \"digest\", 1)\r\n  43:         self.assertNotEqual(base, attempt_key(\"eff-2\", \"subj-1\", \"digest\", 1))\r\n  44:         self.assertNotEqual(base, attempt_key(\"eff-1\", \"subj-2\", \"digest\", 1))\r\n  45:         self.assertNotEqual(base, attempt_key(\"eff-1\", \"subj-1\", \"other\", 1))\r\n  46:         self.assertNotEqual(base, attempt_key(\"eff-1\", \"subj-1\", \"digest\", 2))\r\n  47: \r\n  48:     def test_bad_attempt_no_is_refused(self):\r\n  49:         with self.assertRaises(ValueError):\r\n  50:             attempt_key(\"eff-1\", \"subj-1\", \"digest\", 0)\r\n  51: \r\n  52: \r\n  53: class TestDuplicate(unittest.TestCase):\r\n  54:     def test_existing_key_is_duplicate(self):\r\n  55:         self.assertEqual(classify_retry(attempted(), attempt_no=1), \"DUPLICATE\")\r\n  56: \r\n  57:     def test_new_key_is_new(self):\r\n  58:         self.assertEqual(classify_retry(attempted(), attempt_no=2), \"NEW\")\r\n  59: \r\n  60:     def test_duplicate_attempt_raises(self):\r\n  61:         with self.assertRaises(DuplicateAttemptDetected) as ctx:\r\n  62:             assert_retryable(attempted(), attempt_no=1)\r\n  63:         self.assertEqual(DuplicateAttemptDetected.code, \"ERR_DUPLICATE_ATTEMPT\")\r\n  64: \r\n  65:     def test_second_attempt_with_existing_key_raises(self):\r\n  66:         record = attempted()\r\n  67:         with self.assertRaises(DuplicateAttemptDetected):\r\n  68:             record_attempt(record, actor=\"agent-7\", permission_allowed=True,\r\n  69:                            attempt_key=key_for(record, 1), at=\"t1\")\r\n  70: \r\n  71: \r\n  72: class TestRetryRefusals(unittest.TestCase):\r\n  73:     def test_retry_reconciled_is_refused(self):\r\n  74:         record = readback(observe(attempted(), payload={\"op\": \"create\"},\r\n  75:                                   provider_success=True, at=\"t1\"),\r\n  76:                           payload={\"op\": \"create\"}, expected={\"op\": \"create\"}, at=\"t2\")\r\n  77:         record = reconcile(record, at=\"t3\")\r\n  78:         self.assertEqual(record.state, \"RECONCILED\")\r\n  79:         with self.assertRaises(RetryRefused):\r\n  80:             assert_retryable(record, attempt_no=2)\r\n  81: \r\n  82:     def test_retry_denied_is_refused(self):\r\n  83:         denied = record_attempt(new_intent(), actor=\"a\", permission_allowed=False,\r\n  84:                                 attempt_key=\"k1\", at=\"t0\")\r\n  85:         self.assertEqual(denied.state, \"DENIED\")\r\n  86:         with self.assertRaises(RetryRefused):\r\n  87:             assert_retryable(denied, attempt_no=1)\r\n  88: \r\n  89:     def test_retry_irreversible_is_refused(self):\r\n  90:         record = as_state(attempted(), \"IRREVERSIBLE\")\r\n  91:         with self.assertRaises(RetryRefused):\r\n  92:             assert_retryable(record, attempt_no=2)\r\n  93: \r\n  94:     def test_retry_ceiling_is_hard(self):\r\n  95:         with self.assertRaises(RetryRefused):\r\n  96:             assert_retryable(attempted(), attempt_no=5, max_retries=3)\r\n  97:         self.assertEqual(RetryRefused.code, \"ERR_RETRY_REFUSED\")\r\n  98: \r\n  99:     def test_plan_retry_allows_retry_of_uncertain(self):\r\n 100:         record = as_state(attempted(), \"UNKNOWN_EFFECT\", \"NO_READBACK_FAIL_CLOSED\")\r\n 101:         plan = plan_retry(record)\r\n 102:         self.assertIsInstance(plan, RetryPlan)\r\n 103:         self.assertTrue(plan.allowed)\r\n 104:         self.assertEqual(plan.next_attempt_no, 2)\r\n 105:         self.assertTrue(plan.idempotency_key)\r\n 106: \r\n 107:     def test_plan_retry_refuses_reconciled(self):\r\n 108:         record = as_state(attempted(), \"RECONCILED\")\r\n 109:         plan = plan_retry(record)\r\n 110:         self.assertFalse(plan.allowed)\r\n 111:         self.assertIn(\"RECONCILED\", plan.reason_code)\r\n 112: \r\n 113:     def test_plan_retry_refuses_when_ceiling_reached(self):\r\n 114:         record = as_state(attempted(), \"UNKNOWN_EFFECT\")\r\n 115:         plan = plan_retry(record, max_retries=1)\r\n 116:         self.assertFalse(plan.allowed)\r\n 117:         self.assertEqual(plan.reason_code, \"RETRY_LIMIT_EXCEEDED\")\r\n 118: \r\n 119: \r\n 120: class TestReobserve(unittest.TestCase):\r\n 121:     def test_reobserve_for_unknown_effect(self):\r\n 122:         record = as_state(attempted(), \"UNKNOWN_EFFECT\")\r\n 123:         decision = plan_reobserve(record)\r\n 124:         self.assertTrue(decision[\"reobserve\"])\r\n 125:         self.assertIn(\"UNKNOWN_EFFECT\", decision[\"reason_code\"])\r\n 126: \r\n 127:     def test_reobserve_for_partial_effect(self):\r\n 128:         decision = plan_reobserve(as_state(attempted(), \"PARTIAL_EFFECT\"))\r\n 129:         self.assertTrue(decision[\"reobserve\"])\r\n 130: \r\n 131:     def test_no_reobserve_for_reconciled(self):\r\n 132:         self.assertFalse(plan_reobserve(as_state(attempted(), \"RECONCILED\"))[\"reobserve\"])\r\n 133: \r\n 134: \r\n 135: if __name__ == \"__main__\":\r\n 136:     unittest.main()\r\n########## ADVERSARIAL\r\n   1: \"\"\"Adversarial suite: each case asserts its exact typed error or terminal state.\r\n   2: \r\n   3: These are the failure modes that would let an unverified effect be recorded as success. Every\r\n   4: one must fail closed: an OBSERVATION never becomes truth, uncertainty is terminal, a duplicate\r\n   5: side effect is refused, and an irreversible effect cannot be silently compensated.\r\n   6: \"\"\"\r\n   7: import sys\r\n   8: import unittest\r\n   9: from pathlib import Path\r\n  10: \r\n  11: ROOT = Path(__file__).resolve().parents[3]\r\n  12: sys.path.insert(0, str(ROOT / \"src\"))\r\n  13: \r\n  14: from effect.compensation import (  # noqa: E402\r\n  15:     IrreversibleEffect, assert_compensable, plan_compensation,\r\n  16: )\r\n  17: from effect.idempotency import (  # noqa: E402\r\n  18:     DuplicateAttemptDetected, RetryRefused, assert_retryable, attempt_key, plan_retry,\r\n  19: )\r\n  20: from effect.state import EffectTransitionRefused, assert_transition  # noqa: E402\r\n  21: from effect.substrate import (  # noqa: E402\r\n  22:     EffectStateError, SuccessInferenceRefused, assert_no_success_inference, finalize, intend,\r\n  23:     is_success, observe, readback, reconcile, record_attempt,\r\n  24: )\r\n  25: \r\n  26: PARTS = [{\"part\": \"debit\"}, {\"part\": \"credit\"}]\r\n  27: \r\n  28: \r\n  29: def intended(intent=None):\r\n  30:     return intend(\"eff-1\", \"subj-1\", intent if intent is not None else {\"op\": \"create\"},\r\n  31:                   environment=\"test\")\r\n  32: \r\n  33: \r\n  34: def key_for(record, attempt_no):\r\n  35:     return attempt_key(record.effect_id, record.subject_id, record.intent_digest, attempt_no)\r\n  36: \r\n  37: \r\n  38: def attempted():\r\n  39:     record = intended()\r\n  40:     return record_attempt(record, actor=\"agent-7\", permission_allowed=True,\r\n  41:                           attempt_key=key_for(record, 1), at=\"t0\")\r\n  42: \r\n  43: \r\n  44: def observed(provider_success=True, payload=None, record=None):\r\n  45:     return observe(record if record is not None else attempted(),\r\n  46:                    payload=payload if payload is not None else {\"status\": \"ok\"},\r\n  47:                    provider_success=provider_success, at=\"t1\")\r\n  48: \r\n  49: \r\n  50: class TestAdversarial(unittest.TestCase):\r\n  51:     def test_01_apparent_success_with_no_readback(self):\r\n  52:         record = observed(provider_success=True)\r\n  53:         reconciled = reconcile(record, at=\"t2\")\r\n  54:         self.assertEqual(reconciled.state, \"UNKNOWN_EFFECT\")\r\n  55:         self.assertEqual(reconciled.reason_code, \"NO_READBACK_FAIL_CLOSED\")\r\n  56:         self.assertFalse(is_success(reconciled))\r\n  57: \r\n  58:     def test_02_ambiguous_provider_response_stays_unknown(self):\r\n  59:         record = observed(provider_success=None, payload={\"status\": \"unknown\"})\r\n  60:         self.assertIsNone(record.provider_success)\r\n  61:         self.assertEqual(reconcile(record, at=\"t2\").state, \"UNKNOWN_EFFECT\")\r\n  62:         record = readback(record, payload={\"status\": \"pending\"}, expected=None, at=\"t2\")\r\n  63:         self.assertIsNone(record.readbacks[-1].matches_expected)\r\n  64:         self.assertEqual(finalize(record).state, \"UNKNOWN_EFFECT\")\r\n  65: \r\n  66:     def test_03_duplicate_retry_is_refused(self):\r\n  67:         with self.assertRaises(DuplicateAttemptDetected):\r\n  68:             assert_retryable(attempted(), attempt_no=1)\r\n  69:         with self.assertRaises(DuplicateAttemptDetected):\r\n  70:             record_attempt(attempted(), actor=\"agent-7\", permission_allowed=True,\r\n  71:                            attempt_key=key_for(attempted(), 1), at=\"t1\")\r\n  72: \r\n  73:     def test_04_partial_effect_yields_compensation_pointer(self):\r\n  74:         record = record_attempt(intended({\"op\": \"transfer\", \"parts\": PARTS}), actor=\"agent-7\",\r\n  75:                                 permission_allowed=True, attempt_key=\"k1\", at=\"t0\")\r\n  76:         record = observe(record, payload={\"part\": \"debit\"}, provider_success=True, at=\"t1\")\r\n  77:         record = readback(record, payload={\"part\": \"debit\"}, expected=PARTS, at=\"t2\")\r\n  78:         record = reconcile(record, at=\"t3\")\r\n  79:         self.assertEqual(record.state, \"PARTIAL_EFFECT\")\r\n  80:         self.assertEqual(record.reason_code, \"PARTIAL_EFFECT_DETECTED\")\r\n  81:         pointer = plan_compensation(record, registry={\"eff-1\": {\"kind\": \"ROLLBACK\",\r\n  82:                                                                \"ref\": \"comp-0001\"}})\r\n  83:         self.assertTrue(pointer.compensable)\r\n  84:         self.assertEqual(pointer.ref, \"comp-0001\")\r\n  85: \r\n  86:     def test_05_stale_readback_fails_closed(self):\r\n  87:         record = readback(observed(), payload={\"op\": \"create\"}, expected={\"op\": \"create\"},\r\n  88:                           at=\"t2\", stale=True)\r\n  89:         reconciled = reconcile(record, at=\"t3\")\r\n  90:         self.assertEqual(reconciled.state, \"UNKNOWN_EFFECT\")\r\n  91:         self.assertEqual(reconciled.reason_code, \"STALE_READBACK_FAIL_CLOSED\")\r\n  92: \r\n  93:     def test_06_wrong_subject_readback_is_refused(self):\r\n  94:         with self.assertRaises(EffectStateError) as ctx:\r\n  95:             readback(observed(), payload={\"subject_id\": \"subj-2\", \"op\": \"create\"},\r\n  96:                      expected={\"op\": \"create\"}, at=\"t2\")\r\n  97:         self.assertEqual(ctx.exception.reason_code, \"WRONG_SUBJECT_READBACK\")\r\n  98:         self.assertEqual(EffectStateError.code, \"ERR_EFFECT_STATE\")\r\n  99: \r\n 100:     def test_07_reconciliation_mismatch_fails_closed(self):\r\n 101:         record = readback(observed(), payload={\"op\": \"other\"}, expected={\"op\": \"create\"},\r\n 102:                           at=\"t2\")\r\n 103:         reconciled = reconcile(record, at=\"t3\")\r\n 104:         self.assertEqual(reconciled.state, \"UNKNOWN_EFFECT\")\r\n 105:         self.assertEqual(reconciled.reason_code, \"RECONCILIATION_MISMATCH\")\r\n 106: \r\n 107:     def test_08_denied_permission_records_no_attempt_and_no_success(self):\r\n 108:         record = record_attempt(intended(), actor=\"agent-7\", permission_allowed=False,\r\n 109:                                 attempt_key=\"k1\", at=\"t0\")\r\n 110:         self.assertEqual(record.state, \"DENIED\")\r\n 111:         self.assertEqual(record.reason_code, \"PERMISSION_DENIED\")\r\n 112:         self.assertEqual(record.attempts, ())\r\n 113:         with self.assertRaises(SuccessInferenceRefused):\r\n 114:             assert_no_success_inference(record)\r\n 115: \r\n 116:     def test_09_observed_to_reconciled_transition_is_refused(self):\r\n 117:         with self.assertRaises(EffectTransitionRefused):\r\n 118:             assert_transition(\"OBSERVED\", \"RECONCILED\")\r\n 119:         self.assertEqual(EffectTransitionRefused.code, \"ERR_EFFECT_TRANSITION_REFUSED\")\r\n 120: \r\n 121:     def test_10_irreversible_effect_raises_from_assert_compensable(self):\r\n 122:         record = record_attempt(intended({\"op\": \"send\"}), actor=\"agent-7\",\r\n 123:                                 permission_allowed=True, attempt_key=\"k1\", at=\"t0\")\r\n 124:         pointer = plan_compensation(record, irreversible_attempts=(\"eff-1\",))\r\n 125:         self.assertFalse(pointer.compensable)\r\n 126:         self.assertEqual(pointer.reason_code, \"IRREVERSIBLE_EFFECT\")\r\n 127:         with self.assertRaises(IrreversibleEffect):\r\n 128:             assert_compensable(pointer)\r\n 129: \r\n 130:     def test_11_retry_of_reconciled_effect_is_refused(self):\r\n 131:         record = readback(observed(), payload={\"op\": \"create\"}, expected={\"op\": \"create\"},\r\n 132:                           at=\"t2\")\r\n 133:         record = reconcile(record, at=\"t3\")\r\n 134:         self.assertEqual(record.state, \"RECONCILED\")\r\n 135:         with self.assertRaises(RetryRefused):\r\n 136:             assert_retryable(record, attempt_no=2)\r\n 137:         self.assertEqual(RetryRefused.code, \"ERR_RETRY_REFUSED\")\r\n 138: \r\n 139:     def test_12_finalize_never_returns_unjustified_success(self):\r\n 140:         for record in (intended(), attempted(), observed(True), observed(False)):\r\n 141:             swept = finalize(record)\r\n 142:             self.assertFalse(is_success(swept))\r\n 143:             self.assertEqual(swept.state, \"UNKNOWN_EFFECT\")\r\n 144:         stale = readback(observed(), payload={\"op\": \"create\"}, expected={\"op\": \"create\"},\r\n 145:                          at=\"t2\", stale=True)\r\n 146:         self.assertFalse(is_success(finalize(stale)))\r\n 147: \r\n 148:     def test_13_retry_is_recordable_through_the_public_api(self):\r\n 149:         record = intended()\r\n 150:         record = record_attempt(record, actor=\"agent-7\", permission_allowed=True,\r\n 151:                                 attempt_key=key_for(record, 1), at=\"t0\")\r\n 152:         record = observe(record, payload={\"status\": \"denied\"}, provider_success=False, at=\"t1\")\r\n 153:         record = readback(record, payload={\"op\": \"other\"}, expected={\"op\": \"create\"}, at=\"t2\")\r\n 154:         record = reconcile(record, at=\"t3\")\r\n 155:         self.assertEqual(record.state, \"UNKNOWN_EFFECT\")\r\n 156:         plan = plan_retry(record)\r\n 157:         self.assertTrue(plan.allowed)\r\n 158:         record = record_attempt(record, actor=\"agent-7\", permission_allowed=True,\r\n 159:                                 attempt_key=plan.idempotency_key, at=\"t4\")\r\n 160:         self.assertEqual(record.state, \"ATTEMPTED\")\r\n 161:         self.assertEqual(len(record.attempts), 2)\r\n 162:         record = observe(record, payload={\"status\": \"ok\"}, provider_success=True, at=\"t5\")\r\n 163:         record = readback(record, payload={\"op\": \"create\"}, expected={\"op\": \"create\"}, at=\"t6\")\r\n 164:         record = reconcile(record, at=\"t7\")\r\n 165:         self.assertEqual(record.state, \"RECONCILED\")\r\n 166:         self.assertTrue(is_success(record))\r\n 167: \r\n 168:     def test_14_reconciled_record_cannot_be_retried_through_the_public_api(self):\r\n 169:         record = readback(observed(), payload={\"op\": \"create\"}, expected={\"op\": \"create\"},\r\n 170:                           at=\"t2\")\r\n 171:         record = reconcile(record, at