== producer_id:\r\n 227:         _reject(item, \"CHECKER_EQUALS_PRODUCER\",\r\n 228:                 \"item %s was produced and checked by %r (maker-as-checker)\"\r\n 229:                 % (item_id, checker_id))\r\n 230: \r\n 231:     return {\r\n 232:         \"schema\": \"SWOF-EVIDENCE-ITEM-VERDICT/1\",\r\n 233:         \"item_id\": item_id,\r\n 234:         \"kind\": kind,\r\n 235:         \"linkage_mode\": linkage_mode,\r\n 236:         \"accepted\": True,\r\n 237:         \"reason_code\": \"ACCEPTED\",\r\n 238:     }\r\n 239: \r\n 240: \r\n 241: def validate_plan(plan, items, *, resolver=None):\r\n 242:     \"\"\"Validate a whole evidence plan; never passes on an empty item list.\"\"\"\r\n 243:     items = list(items or ())\r\n 244:     rejected = []\r\n 245:     accepted = []\r\n 246: \r\n 247:     for item in items:\r\n 248:         try:\r\n 249:             verdict = validate_item(item, plan=plan, resolver=resolver)\r\n 250:             accepted.append((item, verdict))\r\n 251:         except EvidenceRejected as exc:\r\n 252:             rejected.append({\r\n 253:                 \"item_id\": exc.item_id,\r\n 254:                 \"kind\": _field(item, \"kind\", None),\r\n 255:                 \"linkage_mode\": _field(item, \"linkage_mode\", None),\r\n 256:                 \"reason_code\": exc.reason_code,\r\n 257:                 \"detail\": str(exc),\r\n 258:             })\r\n 259: \r\n 260:     linkage_modes = {mode: 0 for mode in LINKAGE_MODES}\r\n 261:     for item in items:\r\n 262:         mode = _field(item, \"linkage_mode\", None)\r\n 263:         if mode in linkage_modes:\r\n 264:             linkage_modes[mode] += 1\r\n 265: \r\n 266:     required_entries = _required_entries(plan)\r\n 267:     required_present = 0\r\n 268:     for kind, linkage_mode, environment in required_entries:\r\n 269:         for item, _ in accepted:\r\n 270:             if (_field(item, \"kind\", None) == kind\r\n 271:                     and _field(item, \"linkage_mode\