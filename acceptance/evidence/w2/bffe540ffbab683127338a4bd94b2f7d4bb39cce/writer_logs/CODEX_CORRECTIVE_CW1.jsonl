return clean, scanned'''\nnew_walk_dict = '''    if isinstance(value, dict):\n        clean = {}\n        scanned = 0\n        for key, item in value.items():\n            if _credential_pair(key, item):\n                classes.add(\\\"SECRET\\\")\n                redactions[\\\"SECRET\\\"] = redactions.get(\\\"SECRET\\\", 0) + 1\n                clean[key] = \\\"[REDACTED:SECRET]\\\"\n                scanned += 1\n                continue\n            clean_value, count = _walk(item, redactions, classes)\n            clean[key] = clean_value\n            scanned += count\n        return clean, scanned'''\nassert old_walk_dict in text\ntext = text.replace(old_walk_dict, new_walk_dict, 1)\n\n# 3. Make _secret_survives key-aware.\nold_surv = '''    if isinstance(payload, dict):\n        if not payload:\n            return True\n        return any(_secret_survives(item, depth + 1) for item in payload.values())'''\nnew_surv = '''    if isinstance(payload, dict):\n        if not payload:\n            return True\n        for key, item in payload.items():\n            if _credential_pair(key, item):\n                return True\n            if _secret_survives(item, depth + 1):\n                return True\n        return False'''\nassert old_surv in text\ntext = text.replace(old_surv, new_surv, 1)\n\nopen(path, \\\"w\\\", encoding=\\\"utf-8\\\", newline=\\\"\\\\n\\\").write(text)\nprint(\\\"patched classification.py\\\")\n'@ | python -\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
