{"type":"item.started","item":{"id":"item_87","type":"command_execution","command":"\"C:\\\\Users\\\\user\\\\AppData\\\\Local\\\\Microsoft\\\\WindowsApps\\\\pwsh.exe\" -Command \"cd C:\\\\Projects\\\\Agent_Workspace\\\\SWOF; @'\npath = r\\\"src\\\\assurance\\\\tests\\\\test_oracle.py\\\"\ntext = open(path, \\\"r\\\", encoding=\\\"utf-8\\\", newline=\\\"\\\").read()\n\n# Update the shared item() helper: keep the self-declared field (a claim) and add a proof kind.\nold_helper = '''def item(kind=\\\"TEST_RUN\\\", item_id=\\\"item-1\\\", subject_id=\\\"SUBJ-1\\\", negative_fixtures=(\\\"NEG-1\\\",)):\n    return {\n        \\\"item_id\\\": item_id,\n        \\\"kind\\\": kind,\n        \\\"subject_id\\\": subject_id,\n        \\\"sha256\\\": \\\"a\\\" * 64,\n        \\\"negative_fixtures\\\": negative_fixtures,\n    }\n'''\nnew_helper = '''def item(kind=\\\"TEST_RUN\\\", item_id=\\\"item-1\\\", subject_id=\\\"SUBJ-1\\\", negative_fixtures=(\\\"NEG-1\\\",)):\n    return {\n        \\\"item_id\\\": item_id,\n        \\\"kind\\\": kind,\n        \\\"subject_id\\\": subject_id,\n        \\\"sha256\\\": \\\"a\\\" * 64,\n        \\\"negative_fixtures\\\": negative_fixtures,\n    }\n\n\nMANIFEST = {\\\"NEG-1\\\": \\\"NEGATIVE_FIXTURE_PROOF\\\"}\n\n\ndef proof_item(item_id=\\\"proof-1\\\"):\n    return {\\\"item_id\\\": item_id, \\\"kind\\\": \\\"NEGATIVE_FIXTURE_PROOF\\\", \\\"subject_id\\\": \\\"SUBJ-1\\\",\n            \\\"sha256\\\": \\\"b\\\" * 64}\n'''\nassert old_helper in text\ntext = text.replace(old_helper, new_helper, 1)\n\n# New tests where the ordinary item and its self-declared field are used for the positive case.\nold_neg = '''class TestNegativeRepresentation(unittest.TestCase):\n    def test_unrepresented_negative_fixture_does_not_pass(self):\n        verdict = Oracle(ORACLE_ID).decide(predicate(), [item(negative_fixtures=())])\n        self.assertFalse(verdict.passed)\n        self.assertEqual(verdict.reason_code, \\\"NEGATIVE_FIXTURE_UNREPRESENTED\\\")\n\n    def test_represented_negative_fixture_passes(self):\n        verdict = Oracle(ORACLE_ID).decide(predicate(), [item(negative_fixtures=(\\\"NEG-1\\\",))])\n        self.assertTrue(verdict.passed)\n'''\nnew_neg = '''class TestNegativeRepresentation(unittest.TestCase):\n    def test_self_declared_negative_fixture_does_not_pass(self):\n        items = [item(negative_fixtures=(\\\"NEG-1\\\",))]\n        verdict = Oracle(ORACLE_ID).decide(predicate(), items)\n        self.assertFalse(verdict.passed)\n        self.assertEqual(verdict.reason_code, \\\"NEGATIVE_FIXTURE_UNREPRESENTED\\\")\n\n    def test_self_declared_field_alone_is_not_a_proof(self):\n        ordinary = Oracle(ORACLE_ID).decide(predicate(), [item()])\n        proving = Oracle(ORACLE_ID, negative_fixture_manifest=MANIFEST).decide(\n            predicate(), [item(), proof_item()])\n        self.assertFalse(ordinary.passed)\n        self.assertTrue(proving.passed)\n\n    def test_genuinely_represented_fixture_passes(self):\n        verdict = Oracle(ORACLE_ID, negative_fixture_manifest=MANIFEST).decide(\n            predicate(), [item(), proof_item()])\n        self.assertTrue(verdict.passed)\n        self.assertIsNone(verdict.first_failure)\n\n    def test_manifest_without_the_matching_kind_does_not_pass(self):\n        items = [item(), proof_item()]\n        wrong_kind = Oracle(ORACLE_ID,\n                            negative_fixture_manifest={\\\"NEG-1\\\": \\\"SOME_OTHER_KIND\\\"})\n        verdict = wrong_kind.decide(predicate(), items)\n        self.assertFalse(verdict.passed)\n        self.assertEqual(verdict.reason_code, \\\"NEGATIVE_FIXTURE_UNREPRESENTED\\\")\n'''\nassert old_neg in text\ntext = text.replace(old_neg, new_neg, 1)\n\n# The shared passing verdict now needs a genuine proof for its positive fixture.\nold_pass = '''    def test_passing_verdict(self):\n        verdict = Oracle(ORACLE_ID).decide(predicate(), [item()])\n        self.assertIsInstance(verdict, OracleVerdict)\n        self.assertTrue(verdict.passed)\n        self.assertIsNone(verdict.first_failure)\n        self.assertEqual(verdict.reason_code, \\\"PASS\\\")\n'''\nnew_pass = '''    def test_passing_verdict(self):\n        verdict = Oracle(ORACLE_ID, negative_fixture_manifest=MANIFEST).decide(\n            predicate(), [item(), proof_item()])\n        self.assertIsInstance(verdict, OracleVerdict)\n        self.assertTrue(verdict.passed)\n        self.assertIsNone(verdict.first_failure)\n        self.assertEqual(verdict.reason_code, \\\"PASS\\\")\n'''\nassert old_pass in text\ntext = text.replace(old_pass, new_pass, 1)\n\nold_reach = '''            Oracle(ORACLE_ID).decide(predicate(), [item(item_id=\\\"b\\\"), item(item_id=\\\"a\\\")]).reason_code,\n            Oracle(ORACLE_ID).decide(predicate(), [item()]).reason_code,\n        }\n'''\nnew_reach = '''            Oracle(ORACLE_ID).decide(predicate(), [item(item_id=\\\"b\\\"), item(item_id=\\\"a\\\")]).reason_code,\n            Oracle(ORACLE_ID, negative_fixture_manifest=MANIFEST).decide(\n                predicate(), [item(), proof_item()]).reason_code,\n        }\n'''\nassert old_reach in text\ntext = text.replace(old_reach, new_reach, 1)\n\nopen(path, \\\"w\\\", encoding=\\\"utf-8\\\", newline=\\\"\\\\n\\\").write(text)\nprint(\\\"patched test_oracle.py\\\")\n'@ | python -; python -m unittest discover -s src/assurance/tests -t src/assurance/tests 2>&1 | Select-Object -Last 5\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
