es_at\r\n 140:     if expires is None:\r\n 141:         return False\r\n 142:     if not isinstance(expires, str) or not _ISO_UTC_RE.match(expires):\r\n 143:         return True\r\n 144:     if now is None:\r\n 145:         return True\r\n 146:     if not isinstance(now, str) or not _ISO_UTC_RE.match(now):\r\n 147:         return True\r\n 148:     return now >= expires\r\n 149: \r\n 150: \r\n 151: def currentness_required(scope) -> bool:\r\n 152:     \"\"\"True when the scope carries an expiry, i.e. a trusted `now` must be supplied.\"\"\"\r\n 153:     return scope.expires_at is not None\r\n 154: \r\n 155: \r\n 156: def check_rights(scope, entitlement, *, now=None, subject=None) -> RightsDecision:\r\n 157:     \"\"\"Expired, revoked, unknown, mismatched or malformed entitlements all DENY.\r\n 158: \r\n 159:     A scope with an `expires_at` can only be evaluated against a trusted `now`; omitting it is\r\n 160:     unknown currentness and fails closed. A scope with no expiry has nothing to evaluate and is\r\n 161:     still ENTITLED - that positive control must not regress.\r\n 162:     \"\"\"\r\n 163:     invalid = _scope_valid(scope)\r\n 164:     if invalid is not None:\r\n 165:         return RightsDecision(False, invalid, False)\r\n 166:     if subject is not None and subject != scope.subject:\r\n 167:         return RightsDecision(False, \"SUBJECT_MISMATCH\", False)\r\n 168:     if not isinstance(entitlement, str) or not entitlement:\r\n 169:         return RightsDecision(False, \"ENTITLEMENT_INVALID_FAIL_CLOSED\", False)\r\n 170:     if scope.revoked:\r\n 171:         return RightsDecision(False, \"REVOKED\", False)\r\n 172:     if scope.expires_at is not None and now is None:\r\n 173:         return RightsDecision(False, \"CURRENTNESS_UNAVAILABLE_FAIL_CLOSED\", False)\r\n 174:     if _expired(scope, now):\r\n 175:         return RightsDecision(False, \"EXPIRED\", False)\r\n 176:     if entitlement not in scope.entitlements:\r\n 177:         return RightsDecision(False, \"UNKNOWN_ENTITLEMENT_FAIL_CLOSED\", False)\r\n 178:     gate = entitlement in HIGH_RISK_ACTIONS\r\n 179:     return RightsDecision(True, \"ENTITLED\", gate)\r\n 180: \r\n 181: \r\n 182: def human_gate_required(request) -> HumanGateRoute:\r\n 183:     \"\"\"ONE canonical gate predicate. Risk/permission/autonomy classification is authoritative; the\r\n 184:     operation name may TIGHTEN or identify the route but may NEVER weaken it.\r\n 185: \r\n 186:     Order (normative), all fail closed (DOC-03 15.6):\r\n 187: \r\n 188:       1. RUIN precedence FIRST, before any approval consideration, DERIVED FROM THE CANONICAL\r\n 189:          `effect_risk_tier` (`ruin_precedence_code`):\r\n 190:            \"RUIN\"          -> RUIN_HARD_VETO_ROUTE / \"RUIN:HARD_VETO\"\r\n 191:            \"UNKNOWN_RUIN\"  -> RUIN_SAFE_STOP_ROUTE / \"RUIN:SAFE_STOP\"\r\n 192:            a malformed risk tier and a malformed NON-CANONICAL `ruin_class` alias -> SAFE_STOP.\r\n 193:          A token can never satisfy these; the verifier rejects them before checking approval.\r\n 194:       2. a malformed `effect_risk_tier`, `permission_class` or `autonomy_tier` is unclassifiable and\r\n 195:          fails closed (gated, no authority edge); it is NEVER treated as ungated.\r\n 196:       3. token required if ANY of:\r\n 197:            effect_risk_tier in {\"HIGH\",\"CRITICAL\",\"RUIN\",\"UNKNOWN_RUIN\"}\r\n 198:            permission_class in {\"P3\",\"P4\",\"P5\"}\r\n 199:            autonomy_tier == \"T3\"\r\n 200:            the operation maps to an explicit high-risk authority edge\r\n 201:       4. otherwise an ABSENT classification on a NAMED benign operation is the shim's NONE route;\r\n 202:          an EMPTY / non-string operation name is unknown and is gated (`HUMAN_GATE:unknown_action`),\r\n 203:          so the route shim and the predicate agree on the unknown-operation rule.\r\n 204:     \"\"\"\r\n 205:     ruin = ruin_precedence_code(request)\r\n 206:     if ruin == \"HARD_VETO_RUIN\":\r\n 207:         return HumanGateRoute(True, RUIN_HARD_VETO_ROUTE, \"RUIN:HARD_VETO\")\r\n 208:     if ruin == \"SAFE_STOP_UNKNOWN_RUIN\":\r\n 209:         return HumanGateRoute(True, RUIN_SAFE_STOP_ROUTE, \"RUIN:SAFE_STOP\")\r\n 210: \r\n 211:     risk_state, risk = classify_effect_risk_tier(request)\r\n 212:     permission_state, permission = classify_permission_class(request)\r\n 213:     autonomy_state, autonomy = classify_autonomy_tier(request)\r\n 214:     legacy_state, _ = classify_legacy_ruin_class(request)\r\n 215:     operation = getattr(request, \"operation\", None)\r\n 216: \r\n 217:     # The operation name may TIGHTEN or IDENTIFY the route: a high-risk operation always gates and\r\n 218:     # names its own authority edge, whatever the classification (this can never weaken the law).\r\n 219:     if isinstance(operation, str) and operation in HIGH_RISK_ACTIONS:\r\n 220:         return HumanGateRoute(True, HUMAN_GATE_ROUTE, _AUTHORITY_EDGE[operation])\r\n 221:     # A malformed classification is unclassifiable; it fails closed and is never treated as ungated.\r\n 222:     if _CLASS_MALFORMED in (risk_state, permission_state, autonomy_state, legacy_state):\r\n 223:         return HumanGateRoute(True, HUMAN_GATE_ROUTE, \"HUMAN_GATE:unclassified\")\r\n 224:     if _CLASS_VALID in (risk_state, permission_state, autonomy_state):\r\n 225:         if risk in _TOKEN_REQUIRED_RISK_TIERS or autonomy == \"T3\" \\\r\n 226:                 or permission in _TOKEN_REQUIRED_PERMISSION_CLASSES:\r\n 227:             return HumanGateRoute(True, HUMAN_GATE_ROUTE, _risk_edge(operation))\r\n 228:         # a fully-classified, non-T3, canonical LOW/MEDIUM/P0..P2 action is benign.\r\n 229:         return HumanGateRoute(False, NONE_ROUTE, \"NONE\")\r\n 230:     # every classification is ABSENT. An EMPTY or non-string operation name is unknown -> gated by\r\n 231:     # the ONE predicate (so human_gate_route(\"\") and human_gate_required(operation=\"\") AGREE).\r\n 232:     # A named, untightened benign action is the shim's NONE route; a classification-carrying caller\r\n 233:     # always reaches the VALID branch above, so this can never weaken a supplied classification.\r\n 234:     if isinstance(operation, str) and operation:\r\n 235:         return HumanGateRoute(False, NONE_ROUTE, \"NONE\")\r\n 236:     return HumanGateRoute(True, HUMAN_GATE_ROUTE, \"HUMAN_GATE:unknown_action\")\r\n 237: \r\n 238: \r\n 239: def _risk_edge(operation) -> str:\r\n 240:     \"\"\"The authority edge for a classification-gated action; a high-risk op identifies its edge.\"\"\"\r\n 241:     if isinstance(operation, str) and operation in HIGH_RISK_ACTIONS:\r\n 242:         return _AUTHORITY_EDGE[operation]\r\n 243:     return \"HUMAN_GATE:risk_tier\"\r\n 244: \r\n 245: \r\n 246: def human_gate_route(action, *, risk=\"LOW\") -> HumanGateRoute:\r\n 247:     \"\"\"Action-name shim over the ONE canonical predicate (no second authority path).\r\n 248: \r\n 249:     A non-string or empty action is an unknown action and is gated without an authority edge. Any\r\n 250:     other action is classified by `human_gate_required` via a synthetic request whose classification\r\n 251:     is ABSENT, so the operation name can identify or tighten the route but can never weaken the\r\n 252:     risk/permission law. In particular `human_gate_route(\"\")` and `human_gate_required` on a request\r\n 253:     with an empty operation AGREE: an unknown operation is gated by the ONE canonical predicate.\r\n 254:     \"\"\"\r\n 255:     if not isinstance(action, str) or not action:\r\n 256:         return human_gate_required(ApprovalRequest(operation=\"\"))\r\n 257:     return human_gate_required(ApprovalRequest(operation=action))\r\n 258: \r\n 259: \r\n 260: def assert_credential_scope(scope, use, *, subject=None, now=None) -> None:\r\n 261:     \"\"\"An empty credential scope permits no credential use; unknown use is denied.\r\n 262: \r\n 263:     Currentness is a required input for an expiring credential scope: an omitted `now` raises\r\n 264:     CURRENTNESS_UNAVAILABLE_FAIL_CLOSED and an expired scope raises EXPIRED_CREDENTIAL_SCOPE.\r\n 265:     \"\"\"\r\n 266:     invalid = _scope_valid(scope)\r\n 267:     if invalid is not None:\r\n 268:         raise RightsDenied(invalid)\r\n 269:     if subject is not None and subject != scope.subject:\r\n 270:         raise RightsDenied(\"SUBJECT_MISMATCH\")\r\n 271:     if not isinstance(use, str) or not use:\r\n 272:         raise RightsDenied(\"CREDENTIAL_USE_INVALID_FAIL_CLOSED\")\r\n 273:     if scope.revoked:\r\n 274:         raise RightsDenied(\"REVOKED\")\r\n 275:     if scope.expires_at is not None and now is None:\r\n 276:         raise RightsDenied(\"CURRENTNESS_UNAVAILABLE_FAIL_CLOSED\")\r\n 277:     if _expired(scope, now):\r\n 278:         raise RightsDenied(\"EXPIRED_CREDENTIAL_SCOPE\")\r\n 279:     if use not in scope.credential_scope:\r\n 280:         raise RightsDenied(\"CREDENTIAL_USE_OUT_OF_SCOPE: %s\" % use)\r\n 281: \r\n 282: \r\n 283: def _requires_typed_token(request) -> bool:\r\n 284:     \"\"\"True when a request demands a typed approval token; a malformed/absent classification does.\r\n 285: \r\n 286:     A present-but-malformed enum fails closed (True), never a permissive default.\r\n 287:     \"\"\"\r\n 288:     tier_state, tier = classify_effect_risk_tier(request)\r\n 289:     permission_state, permission = classify_permission_class(request)\r\n 290:     autonomy_state, autonomy = classify_autonomy_tier(request)\r\n 291:     if _CLASS_MALFORMED in (tier_state, permission_state, autonomy_state):\r\n 292:         return True\r\n 293:     return (tier in _TOKEN_REQUIRED_RISK_TIERS\r\n 294:             or permission in _TOKEN_REQUIRED_PERMISSION_CLASSES\r\n 295:             or autonomy == \"T3\")\r\n 296: \r\n 297: \r\n 298: def _route_is_ruin(route) -> bool:\r\n 299:     return route.route in (RUIN_HARD_VETO_ROUTE, RUIN_SAFE_STOP_ROUTE)\r\n 300: \r\n 301: \r\n 302: def assert_human_gate_satisfied(route, approval, *, requesting_actor=None,\r\n 303:                                 request=None, ctx=None) -> None:\r\n 304:     \"\"\"Refuse a missing, self-issued or non-exact-bound approval for a gated route.\r\n 305: \r\n 306:     The route is re-derived from the REQUEST via the ONE canonical predicate, never trusted. A\r\n 307:     `required=False` route is only honoured when an `ApprovalRequest` is supplied and the\r\n 308:     predicate agrees the action is ungated; otherwise the route understates the action\r\n 309:     (`ROUTE_UNDERSTATES_ACTION`) or cannot be re-derived (`ROUTE_NOT_REDERIVABLE_FAIL_CLOSED`).\r\n 310: \r\n 311:     RUIN / UNKNOWN_RUIN precedence is evaluated FIRST and raises `HARD_VETO_RUIN` /\r\n 312:     `SAFE_STOP_UNKNOWN_RUIN` REGARDLESS of the token, before any token check.\r\n 313: \r\n 314:     A gated route requires a typed, exact-bound `ApprovalToken` plus the `ApprovalRequest` it is\r\n 315:     bound to and a `VerificationContext` carrying trusted currentness. Any bare string, mapping or\r\n 316:     absent object is refused: a syntactic string is not an approval. For a P3/P4/P5 action the\r\n 317:     refusal of a non-token is the canonical `DENY_P3_TOKEN_REQUIRED`.\r\n 318:     \"\"\"\r\n 319:     if not isinstance(route, HumanGateRoute):\r\n 320:         raise HumanGateBypassAttempt(\"UNKNOWN_ROUTE_FAIL_CLOSED\")\r\n 321: \r\n 322:     # D2: ruin precedence FIRST, before any approval consideration; a token can never satisfy it.\r\n 323:     if request is not None:\r\n 324:         ruin = _ruin_veto_code(request)\r\n 325:         if ruin is not None:\r\n 326:             raise HumanGateBypassAttempt(ruin)\r\n 327:     if _route_is_ruin(route):\r\n 328:         raise HumanGateBypassAttempt(\r\n 329:             \"HARD_VETO_RUIN\" if route.route == RUIN_HARD_VETO_ROUTE else \"SAFE_STOP_UNKNOWN_RUIN\")\r\n 330: \r\n 331:     if request is not None:\r\n 332:         derived = human_gate_required(request)\r\n 333:         if derived.required != route.required:\r\n 334:             raise HumanGateBypassAttempt(\"ROUTE_UNDERSTATES_ACTION\")\r\n 335: \r\n 336:     if not route.required:\r\n 337:         if request is None:\r\n 338:             raise HumanGateBypassAttempt(\"ROUTE_NOT_REDERIVABLE_FAIL_CLOSED\")\r\n 339:         return\r\n 340: \r\n 341:     if not isinstance(approval, ApprovalToken) or request is None or ctx is None:\r\n 342:         if request is not None and _requires_typed_token(request):\r\n 343:             raise HumanGateBypassAttempt(\"DENY_P3_TOKEN_REQUIRED\")\r\n 344:         raise HumanGateBypassAttempt(\"NOT_A_CANONICAL_APPROVAL_TOKEN\")\r\n 345: \r\n 346:     decision = verify_approval_token(approval, request, ctx)\r\n 347:     if not decision.ok:\r\n 348:         raise HumanGateBypassAttempt(decision.code)\r\n 349:     if isinstance(requesting_actor, str) and requesting_actor.strip():\r\n 350:         if approval.approver.strip() == requesting_actor.strip():\r\n 351:             raise HumanGateBypassAttempt(\"SELF_APPROVAL_REFUSED\")\r\n 352:     return None\r\n 353: \r\n 354: \r\n 355: def _ruin_veto_code(request):\r\n 356:     \"\"\"The HARD_VETO/SAFE_STOP code for a request, or None; derived from the canonical field.\"\"\"\r\n 357:     return ruin_precedence_code(request)\r\n 358: \r\n 359: \r\n 360: __all__ = [\r\n 361:     \"EFFECT_RISK_TIERS\", \"HIGH_RISK_ACTIONS\", \"HUMAN_GATE_ROUTE\", \"NONE_ROUTE\",\r\n 362:     \"RUIN_HARD_VETO_ROUTE\", \"RUIN_SAFE_STOP_ROUTE\", \"ApprovalDecision\", \"ApprovalRequest\",\r\n 363:     \"ApprovalToken\", \"HumanGateBypassAttempt\", \"HumanGateRoute\", \"NonceLedger\", \"RightsDecision\",\r\n 364:     \"RightsDenied\", \"RightsScope\", \"VerificationContext\", \"assert_credential_scope\",\r\n 365:     \"assert_human_gate_satisfied\", \"check_rights\", \"currentness_required\", \"human_gate_required\",\r\n 366:     \"human_gate_route\", \"verify_approval_token\",\r\n 367: ]\r\n","exit_code":0,"s