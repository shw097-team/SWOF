{"type":"item.completed","item":{"id":"item_44","type":"command_execution","command":"\"C:\\\\Users\\\\user\\\\AppData\\\\Local\\\\Microsoft\\\\WindowsApps\\\\pwsh.exe\" -Command \"Get-Content -LiteralPath 'C:\\\\Projects\\\\Agent_Workspace\\\\HG-KSEOS\\\\var\\\\swof-construction-002-w2-repair-001\\\\r2_03_probes.py' -Raw\"","aggregated_output":"#!/usr/bin/env python\n\"\"\"R2 machine-replayable probes for the two blocking external findings.\n\nDrives the SHIPPED seams (no copies). Fixtures come from the writer's test module namespace so the\nclass identities match (importing the product under a second package path creates duplicate classes and\nfabricates type-guard failures).\n\"\"\"\nimport json, sys\nfrom pathlib import Path\n\nSWOF = Path(r\"C:\\Projects\\Agent_Workspace\\SWOF\")\nsys.path.insert(0, str(SWOF))\nsys.path.insert(0, str(SWOF / \"src\" / \"security\" / \"tests\"))\n\nimport test_humangate_currentness as H  # noqa: E402\n\nrows = []\n\n\ndef probe(pid, finding, what, fn, expect):\n    \"\"\"expect: True (must be allowed) | False (must be refused) | str (reason code substring).\"\"\"\n    try:\n        r = fn()\n        obs = {\"ok\": getattr(r, \"ok\", None), \"code\": getattr(r, \"code\", None), \"returned\": repr(r)[:60]\n               if getattr(r, \"ok\", None) is None else None}\n        blocked = (obs[\"ok\"] is False)\n    except Exception as e:  # noqa: BLE001\n        obs = {\"raised\": type(e).__name__, \"message\": str(e)[:150]}\n        blocked = True\n    if isinstance(expect, bool):\n        holds = (blocked != expect)\n    else:\n        holds = expect in json.dumps(obs)\n    rows.append({\"probe\": pid, \"finding\": finding, \"case\": what, \"expected\": expect,\n                 \"observed\": obs, \"holds\": bool(holds)})\n    return bool(holds)\n\n\ngate = H.human_gate_required\nsat = H.assert_human_gate_satisfied\nreq = H._release_request\nctx = H._release_ctx\nverify = H.verify_approval_token\ntok = H._valid_token\n\nallok = True\n\n# ---- F-W2-R2-001 D1: risk/permission classification itself requires a token --------------------\nfor tier in (\"P3\", \"P4\", \"P5\"):\n    r = req(effect_risk_tier=tier, permission_class=tier, operation=\"read\")\n    allok &= probe(f\"D1-{tier}\", \"F-W2-R2-001\", f\"{tier} + benign operation 'read' + NO token\",\n                   lambda r=r: sat(gate(r), \"sure go ahead\", request=r, ctx=None),\n                   \"DENY_P3_TOKEN_REQUIRED\")\nr = req(effect_risk_tier=\"P2\", permission_class=\"P3\", operation=\"read\")\nallok &= probe(\"D1-perm-only\", \"F-W2-R2-001\", \"P3 via permission_class only + benign op + no token\",\n               lambda: sat(gate(r), \"sure go ahead\", request=r, ctx=None), \"DENY_P3_TOKEN_REQUIRED\")\nr2 = req(effect_risk_tier=\"P2\", permission_class=\"P2\", operation=\"read\")\nallok &= probe(\"D1-P2-control\", \"F-W2-R2-001\", \"P2 + benign op + no token -> must remain ungated\",\n               lambda: sat(gate(r2), None, request=r2, ctx=None), True)\n\n# ---- F-W2-R2-001 D2: ruin precedence, a token may never override ------------------------------\nfor ruin, code in ((\"RUIN\", \"HARD_VETO_RUIN\"), (\"UNKNOWN_RUIN\", \"SAFE_STOP_UNKNOWN_RUIN\")):\n    r = req(ruin_class=ruin)\n    allok &= probe(f\"D2-{ruin}-token\", \"F-W2-R2-001\",\n                   f\"valid typed token + ruin_class={ruin} -> token cannot override\",\n                   lambda r=r: sat(gate(r), tok(), request=r, ctx=ctx()), code)\n    r2 = req(ruin_class=ruin)\n    allok &= probe(f\"D2-{ruin}-notoken\", \"F-W2-R2-001\", f\"no token + ruin_class={ruin}\",\n                   lambda r=r2: sat(gate(r), None, request=r2, ctx=None), code)\n\n# ---- F-W2-R2-002/W2R1-EXT-002 D3: basis / lineage / integrity ----------------------------------\nallok &= probe(\"D3-basis\", \"W2R1-EXT-002\", \"valid token but WRONG approval_basis_hash\",\n               lambda: H._verify(request_over={\"decision_basis_hash\": \"b\" * 64}), \"DENY_APPROVAL_BASIS\")\nallok &= p