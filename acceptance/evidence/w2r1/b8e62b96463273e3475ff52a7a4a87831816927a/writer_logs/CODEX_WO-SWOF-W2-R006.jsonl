n never smuggle an irreversible/external effect past the gate.\r\n 302:     if classes & _OPERATION_TIGHTENED:\r\n 303:         edge = sorted(classes & _OPERATION_TIGHTENED)[0]\r\n 304:         return HumanGateRoute(True, HUMAN_GATE_ROUTE, \"HUMAN_GATE:%s\" % edge)\r\n 305:     # A malformed classification is unclassifiable; it fails closed and is never treated as ungated.\r\n 306:     if _CLASS_MALFORMED in (risk_state, permission_state, autonomy_state, legacy_state):\r\n 307:         return HumanGateRoute(True, HUMAN_GATE_ROUTE, \"HUMAN_GATE:unclassified\")\r\n 308:     if _CLASS_VALID in (risk_state, permission_state, autonomy_state):\r\n 309:         if risk in _TOKEN_REQUIRED_RISK_TIERS or autonomy == \"T3\" \\\r\n 310:                 or permission in _TOKEN_REQUIRED_PERMISSION_CLASSES:\r\n 311:             return HumanGateRoute(True, HUMAN_GATE_ROUTE, _risk_edge(operation))\r\n 312:         # a fully-classified, non-T3, canonical LOW/MEDIUM/P0..P2 action is benign: the operation is\r\n 313:         # KNOWN (an unclassifiable one SAFE-STOPPED above), so this is the positive control.\r\n 314:         return HumanGateRoute(False, NONE_ROUTE, \"NONE\")\r\n 315:     # every classification is ABSENT and the operation is KNOWN. A KNOWN benign operation keeps the\r\n 316:     # NONE route; a KNOWN operation with no tightening edge is untightened and stays ungated. An\r\n 317:     # unclassifiable operation never reaches here: it SAFE-STOPPED above.\r\n 318:     return HumanGateRoute(False, NONE_ROUTE, \"NONE\")\r\n 319: \r\n 320: \r\n 321: def _risk_edge(operation) -> str:\r\n 322:     \"\"\"The authority edge for a classification-gated action; a high-risk op identifies its edge.\r\n 323: \r\n 324:     R6: only a KNOWN operation reaches a classification-gated edge with its own name; an unclassifiable\r\n 325:     operation has already SAFE-STOPPED in the ONE predicate and never arrives here.\r\n 326:     \"\"\"\r\n","exit_code":0,"status":"completed"}}
