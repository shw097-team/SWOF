F_PREFIX = \"human:\"\r\n120: _NON_HUMAN_REF_PREFIXES = (\r\n128: EFFECT_RISK_TIERS = (\"LOW\", \"MEDIUM\", \"HIGH\", \"CRITICAL\", \"RUIN\", \"UNKNOWN_RUIN\")\r\n129: PERMISSION_CLASSES = (\"P0\", \"P1\", \"P2\", \"P3\", \"P4\", \"P5\")\r\n130: AUTONOMY_TIERS = (\"T0\", \"T1\", \"T2\", \"T3\")\r\n133: _TOKEN_REQUIRED_RISK_TIERS = frozenset({\"HIGH\", \"CRITICAL\", \"RUIN\", \"UNKNOWN_RUIN\"})\r\n135: _TOKEN_REQUIRED_PERMISSION_CLASSES = frozenset({\"P3\", \"P4\", \"P5\"})\r\n137: _ROLLBACK_TRIGGER_TIERS = (\"P3\", \"P4\", \"P5\")\r\n142: _LEGACY_RUIN_CLASSES = (\"NONE\", \"RUIN\", \"UNKNOWN_RUIN\")\r\n148: APPROVAL_DENY_CODES = (\r\n167: _ESCAPES = {'\"': '\\\\\"', \"\\\\\": \"\\\\\\\\\", \"\\b\": \"\\\\b\", \"\\f\": \"\\\\f\", \"\\n\": \"\\\\n\", \"\\r\": \"\\\\r\",\r\n169: _MAX_SAFE_INTEGER = 2 ** 53 - 1\r\n172: class JCSError(ValueError):\r\n176: def _jcs_escape(text: str) -> str:\r\n190: def _jcs_number(value) -> str:\r\n222: def _jcs_value(value) -> str:\r\n246: def jcs_dumps(obj) -> bytes:\r\n257: def _canonical_set(atoms, key_name):\r\n278: def _canonical_token_body(token) -> dict:\r\n292: def canonical_payload_bytes(token) -> bytes:\r\n304: def approval_basis_hash(decision_basis_hash, effect_digest, generation_bundle_digest,\r\n331: def _token_body(token) -> dict:\r\n341: APPROVAL_DECISION_BASIS_FIELDS = (\r\n348: def approval_decision_basis_hash(decision) -> str:\r\n366: class HumanGateDecision:\r\n400: class ApprovalDecision:\r\n409: class ApprovalToken:\r\n462: class ApprovalRequest:\r\n510: class VerificationContext:\r\n552: class NonceLedger:\r\n569: def _deny(code, detail=\"\"):\r\n573: def _is_nonempty_str(value) -> bool:\r\n577: def _is_str_tuple(value) -> bool:\r\n585: def _is_int_or_none(value) -> bool:\r\n592: _CLASS_ABSENT = \"ABSENT\"\r\n593: _CLASS_VALID = \"VALID\"\r\n594: _CLASS_MALFORMED = \"MALFORMED\"\r\n597: def _classify_domain(value, domain):\r\n606: def classify_effect_risk_tier(request):\r\n611: def classify_permission_class(request)