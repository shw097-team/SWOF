\",\"subject\",\"subject_hash\",\"semantic_version\",\"actor\",\"operation\",\"target_system\",\"resource\",\"environment\",\"purpose_ref\",\"scope\",\"data_class\",\"action_class\",\"subject_risk_class\",\"effect_risk_tier\",\"autonomy_tier\",\"permission_class\",\"resource_class\",\"domain_profile_id\",\"required_authority\",\"required_authn_assurance\",\"approval_view_schema_version\",\"evidence_summary_ref\",\"downside_ref\",\"irreversibility_ref\",\"rollback_ref\",\"rights_generation_ref\",\"consent_generation_ref\",\"security_policy_generation_ref\",\"provider_generation_ref\",\"ruin_generation_ref\",\"created_at\",\"expires_at\",\"approval_basis_taint_state\",\"integrity_ref\"],\r\n1091:     \"authn_assurance_class\":{\"enum\":[\"AAC1\",\"AAC2\",\"AAC3\"]},\r\n1672: | PI-PKG-12 Physical AI | robot/OEM actuation | P3+/HIGH+ + HA3 physical-safety coapproval; AAC2/3; IF-06C Ruin dominant | kill/safe-stop/world-effect readback |\r\n2144: | APPROVER_AUTHN_ASSURANCE_SPEC | AAC1/2/3, reauth/session/credential currentness | DOC03-ACC-003A | OR-D03-AUTHN | stale authn/false Human |\r\n2338: | PD03-06 | Approver identity/delegation/AuthnContext AAC1/2/3 | Human identity/surface owner | fake-Human/stale-authn/P4-P5 authority tests |\r\n2363: | APPROVER_AUTHN_ASSURANCE_SPEC | AAC1–AAC3 + reauth/session/credential generations |\r\n","exit_code":0,"status":"completed"}}
