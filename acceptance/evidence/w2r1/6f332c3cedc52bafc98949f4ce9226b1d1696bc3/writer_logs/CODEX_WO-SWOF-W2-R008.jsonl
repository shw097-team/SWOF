{"type":"item.completed","item":{"id":"item_43","type":"command_execution","command":"\"C:\\\\Users\\\\user\\\\AppData\\\\Local\\\\Microsoft\\\\WindowsApps\\\\pwsh.exe\" -Command \"Get-Content -LiteralPath \\\"C:\\\\Projects\\\\Agent_Workspace\\\\HG-KSEOS\\\\var\\\\swof-construction-002-w2-repair-001\\\\r3_03_probes.py\\\" -Raw\"","aggregated_output":"#!/usr/bin/env python\n\"\"\"R3 verification probes for the three product findings. Every expected value is LITERAL/source-derived\nand none is computed by the helper under test.\"\"\"\nimport json, sys\nfrom pathlib import Path\n\nSWOF = Path(r\"C:\\Projects\\Agent_Workspace\\SWOF\")\nsys.path.insert(0, str(SWOF / \"src\"))\nsys.path.insert(0, str(SWOF / \"src\" / \"security\" / \"tests\"))\nimport test_humangate_currentness as H  # noqa: E402\n\nGOLDEN = \"2a868198e40141f4ccfdcf5767fcb4f5950a3c241fc04b32de7d173cb79e6992\"\nOLD_BAD = \"b7965468fb4b11f51c44342d8aefe92c2120a8eb5ed648678f3c09d85eb91080\"\nrows = []\n\n\ndef rec(pid, finding, what, ok, observed):\n    rows.append({\"probe\": pid, \"finding\": finding, \"case\": what, \"holds\": bool(ok),\n                 \"observed\": observed})\n\n\n# ---- A. exact §15.5 bytes ----------------------------------------------------------------------\ngot = H.approval_basis_hash(\"a\" * 64, \"a\" * 64, \"a\" * 64, \"a\" * 64, \"a\" * 64, \"1.0\")\nrec(\"A1\", \"A\", \"literal golden vector from the frozen formula\", got == GOLDEN, {\"got\": got, \"want\": GOLDEN})\nrec(\"A2\", \"A\", \"the old newline-separated recipe is REJECTED\", got != OLD_BAD, {\"old\": OLD_BAD})\ntry:\n    d = H._verify(request_over={\"decision_basis_hash\": \"b\" * 64})\n    rec(\"A3\", \"A\", \"otherwise-valid token with wrong basis -> deny\",\n        d.ok is False, {\"ok\": d.ok, \"code\": d.code})\nexcept Exception as e:  # noqa: BLE001\n    rec(\"A3\", \"A\", \"otherwise-valid token with wrong basis -> deny\", True, {\"raised\": str(e)[:60]})\n\n# ---- B. authority / HumanGateDecision lineage ---------------------------------------------------\ndef V(**kw):\n    return H._verify(**kw)\n\n\ncases = [\n    (\"B1\", \"insufficient authority for the requirement\", {\"decision_resolver\": H._decision_registry(\n        {\"dec-1\": H._current_decision(authority_class=\"HA1\")})}, False),\n    (\"B3\", \"unknown authority class HA9\", {\"decision_resolver\": H._decision_registry(\n        {\"dec-1\": H._current_decision(authority_class=\"HA9\")})}, False),\n    (\"B4\", \"nonexistent decision_id\", {\"decision_resolver\": H._decision_registry({})}, False),\n    (\"B5\", \"decision bound to ANOTHER request\", {\"decision_resolver\": H._decision_registry(\n        {\"dec-1\": H._current_decision(request_id=\"req-other\")})}, False),\n    (\"B6\", \"decision_id not matching the token\", {\"decision_resolver\": H._decision_registry(\n        {\"dec-1\": H._current_decision(decision_id=\"dec-other\")})}, False),\n    (\"B9\", \"absent authority_policy -> fail closed\", {\"authority_policy\": None}, False),\n    (\"B8\", \"canonical current decision + sufficient authority -> PASS (positive control)\", {}, True),\n]\nfor pid, what, over, expect_ok in cases:\n    try:\n        d = V(ctx_over=over)\n        rec(pid, \"B\", what, d.ok is expect_ok, {\"ok\": d.ok, \"code\": d.code})\n    except Exception as e:  # noqa: BLE001\n        rec(pid, \"B\", what, expect_ok is False, {\"raised\": str(e)[:70]})\n\n# ---- C. canonical signed sets -------------------------------------------------------------------\nt = H._valid_token()\ntry:\n    p1 = H.canonical_payload_bytes(t)\n    # rebuild the SAME token with permuted set-valued fields, re-signed over the canonical bytes\n    import dataclasses\n    # MUST use genuinely multi-element sets: reversing a 1-element list is a no-op and would make this\n    # probe vacuous (a real trap - an earlier battery looked green while a fail-open existed).\n    t = dataclasses.replace(t,\n                            resource=(\"artifact:z\", \"artifact:a\", \"artifact:m\"),\n                            scope=(\"scope:beta\", \"scope:alpha\", \"scope:gamma\"))\n    t = dataclasses.replace(t, signature=H._sign_payload(H.canonical_payload_bytes(t)))\n    p1 = H.canonical_payload_bytes(t)\n    t2 = dataclasses.replace(t, resource=tuple(reversed(tuple(t.resource))),\n                             scope=tuple(reversed(tuple(t.scope))))\n    t2 = dataclasses.replace(t2, signature=H._sign_payload(H.canonical_payload_bytes(t2)))\n    p2 = H.canonical_payload_bytes(t2)\n    rec(\"C1/C2\", \"C\", \"permuting a 3-atom resource AND 3-atom scope yields IDENTICAL canonical bytes\",\n        p1 == p2, {\"equal\": p1 == p2,\n                   \"resource\": list(t.resource), \"scope\": list(t.scope)})\nexcept Exception as e:  # noqa: BLE001\n    rec(\"C1/C2\", \"C\", \"permutation invariance\", False, {\"error\": str(e)[:90]})\n\ntry:\n    H._verify(token_over={\"resource\": (\"artifact:a\", \"artifact:a\")})\n    rec(\"C4\", \"C\", \"duplicate resource atom -> deny\", False, {\"note\": \"was accepted\"})\nexcept Exception as e:  # noqa: BLE001\n    rec(\"C4\", \"C\", \"duplicate resource atom -> deny\", True, {\"raised\": str(e)[:60]})\n\nsch = json.loads((SWOF / \"schemas\" / \"security\" / \"approval_token.schema.json\").read_text(encoding=\"utf-8\"))\ndef ann(field):\n    node = sch.get(\"properties\", {}).get(field, {})\n    return node.get(\"x-swof-collection-semantics\")\nrec(\"C6\", \"C\", 'schema resource annotation == \"set\"', ann(\"resource\") == \"set\", {\"got\": ann(\"resource\")})\nrec(\"C7\", \"C\", 'schema scope annotation == \"set\"', ann(\"scope\") == \"set\", {\"got\": ann(\"scope\")})\n\n# ---- prior invariants retained ------------------------------------------------------------------\nPRI = [(\"P-p3\", \"P3 + benign op + no token -> DENY_P3_TOKEN_REQUIRED\",\n        lambda: H.assert_human_gate_satisfied(H.human_gate_required(\n            H._release_request(effect_risk_tier=\"LOW\", permission_class=\"P3\", operation=\"read\")),\n            None, request=H._release_request(effect_risk_tier=\"LOW\", permission_class=\"P3\", operation=\"read\"),\n            ctx=None), \"DENY_P3_TOKEN_REQUIRED\"),\n       (\"P-ruin\", \"canonical RUIN + valid token -> HARD_VETO_RUIN\",\n        lambda: H.assert_human_gate_satisfied(H.human_gate_required(\n            H._release_request(effect_risk_tier=\"RUIN\")), H._valid_token(),\n            request=H._release_request(effect_risk_tier=\"RUIN\"), ctx=H._release_ctx()), \"HARD_VETO_RUIN\"),\n       (\"P-unknownruin\", \"canonical UNKNOWN_RUIN -> SAFE_STOP_UNKNOWN_RUIN\",\n        lambda: H.assert_human_gate_satisfied(H.human_gate_required(\n            H._release_request(effect_risk_tier=\"UNKNOWN_RUIN\")), None,\n            request=H._release_request(effect_risk_tier=\"UNKNOWN_RUIN\"), ctx=None),\n        \"SAFE_STOP_UNKNOWN_RUIN\")]\nfor pid, what, fn, want in PRI:\n    try:\n        fn(); rec(pid, \"prior\", what, False, {\"note\": \"did not refuse\"})\n    except Exception as e:  # noqa: BLE001\n        rec(pid, \"prior\", what, want in str(e), {\"raised\": str(e)[:60]})\n\nout = {\"schema\": \"SWOF-W2-R3-VERIFICATION-PROBES/1\",\n       \"subject\": \"0b8ecb0888fbd53b5698f603c90b580ac83dd69d\",\n       \"findings\": {\n           \"A_exact_basis_bytes\": \"CLOSED\" if all(r[\"holds\"] for r in rows if r[\"finding\"] == \"A\") else \"NOT_CLOSED\",\n           \"B_authority_lineage\": \"CLOSED\" if all(r[\"holds\"] for r in rows if r[\"finding\"] == \"B\") else \"NOT_CLOSED\",\n           \"C_canonical_sets\": \"CLOSED\" if all(r[\"holds\"] for r in rows if r[\"finding\"] == \"C\") else \"NOT_CLOSED\",\n           \"prior_invariants\": \"RETAINED\" if all(r[\"holds\"] for r in rows if r[\"finding\"] == \"prior\") else \"REGRESSED\"},\n       \"probes_total\": len(rows), \"probes_holding\": sum(1 for r in rows if r[\"holds\"]),\n       \"all_hold\": all(r[\"holds\"] for r in rows), \"rows\": rows}\np = Path(sys.argv[1]) if len(sys.argv) > 1 else Path(\"R3_PRODUCT_PROBES.json\")\np.write_text(json.dumps(out, ensure_ascii=False, indent=1, default=str) + \"\\n\", encoding=\"utf-8\")\nfor r in rows:\n    print(f\"{r['probe']:14s} holds={str(r['holds']):5s} {json.dumps(r['observed'], ensure_ascii=False, default=str)[:88]}\")\nprint(\"ALL HOLD:\", out[\"all_hold\"], \"|\", out[\"findings\"])\n\r\n","exit_code":0,"status":"completed"}}
