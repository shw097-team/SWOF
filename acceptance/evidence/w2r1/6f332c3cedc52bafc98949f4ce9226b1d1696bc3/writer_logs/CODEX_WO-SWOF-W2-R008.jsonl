tarted = time.strftime(\"%Y-%m-%dT%H:%M:%SZ\", time.gmtime())\n    t0 = time.time()\n    p = subprocess.run([str(PY), \"-m\", \"unittest\", \"discover\", \"-s\", root, \"-t\", top],\n                       cwd=str(T), capture_output=True, text=True)\n    dur = time.time() - t0\n    combined = (p.stdout or \"\") + \"\\n\" + (p.stderr or \"\")\n    ran, ok = 0, False\n    for line in combined.replace(\"\\r\", \"\\n\").split(\"\\n\"):\n        if line.startswith(\"Ran \") and \" test\" in line:\n            ran = int(line.split()[1])\n        if line.strip() == \"OK\":\n            ok = True\n    log = RAW / f\"{phase}_{root.replace('/', '_')}.log\"\n    log.write_text(f\"# command : {PY} -m unittest discover -s {root} -t {top}\\n# cwd     : {T}\\n\"\n                   f\"# git HEAD: {head}\\n# branch  : {git('rev-parse','--abbrev-ref','HEAD').stdout.strip()}\\n\"\n                   f\"# python  : {sys.version.split()[0]}\\n# phase   : {phase}\\n# started : {started}\\n\"\n                   f\"# duration: {dur:.3f}s\\n# exit_code: {p.returncode}\\n\" + \"-\" * 78 + \"\\n\" + combined,\n                   encoding=\"utf-8\", newline=\"\\n\")\n    return {\"label\": label, \"root\": root, \"ran\": ran, \"exit_code\": p.returncode, \"ok\": ok,\n            \"raw_log\": f\"raw_test_logs/{log.name}\", \"sha256\": sha(log)}\n\n\ndef main():\n    RAW.mkdir(parents=True, exist_ok=True)\n    head = git(\"rev-parse\", \"HEAD\").stdout.strip()\n    branch = git(\"rev-parse\", \"--abbrev-ref\", \"HEAD\").stdout.strip()\n    dirty = [l for l in git(\"status\", \"--porcelain\").stdout.splitlines() if l.strip()]\n    w1 = [run(r, r, t, head, \"w2_candidate_w1\") for r, t in W1_ROOTS]\n    w2 = [run(r, r, t, head, \"w2_candidate_w2\") for r, t in W2_ROOTS]\n    w1_total = sum(r[\"ran\"] for r in w1)\n    w2_total = sum(r[\"ran\"] for r in w2)\n    doc = {\n        \"schema\": \"SWOF-W2-R1-TEST-DENOMINATOR/1\", \"candidate\": head, \"branch\": branch,\n        \"repair_id\": \"SWOF-