{"type":"item.completed","item":{"id":"item_52","type":"command_execution","command":"\"C:\\\\Users\\\\user\\\\AppData\\\\Local\\\\Microsoft\\\\WindowsApps\\\\pwsh.exe\" -Command \"Get-Content -LiteralPath \\\"C:\\\\Projects\\\\Agent_Workspace\\\\HG-KSEOS\\\\var\\\\swof-construction-002-w2-repair-001\\\\r2_03c_floor.py\\\" -Raw\"","aggregated_output":"#!/usr/bin/env python\n\"\"\"The headline case the obsolete battery never tested: a CANONICAL effect_risk_tier with a\nP3 permission_class. The permission floor must still require a token even when the effect tier is LOW.\"\"\"\nimport json, sys\nfrom pathlib import Path\n\nSWOF = Path(r\"C:\\Projects\\Agent_Workspace\\SWOF\")\nsys.path.insert(0, str(SWOF))\nsys.path.insert(0, str(SWOF / \"src\" / \"security\" / \"tests\"))\nimport test_humangate_currentness as H  # noqa: E402\n\ngate, sat, req, tok, ctx = (H.human_gate_required, H.assert_human_gate_satisfied, H._release_request,\n                            H._valid_token, H._release_ctx)\nrows = []\n\n\ndef run(pid, what, fn, expect):\n    try:\n        r = fn(); obs = {\"ok\": getattr(r, \"ok\", None), \"code\": getattr(r, \"code\", None)}; blocked = obs[\"ok\"] is False\n        raised = None\n    except Exception as e:  # noqa: BLE001\n        obs, blocked, raised = {\"raised\": type(e).__name__}, True, str(e)[:70]\n    text = json.dumps(obs) + str(raised or \"\")\n    holds = (blocked != expect) if isinstance(expect, bool) else (expect in text)\n    rows.append({\"probe\": pid, \"case\": what, \"expected\": expect, \"observed\": obs, \"raised\": raised,\n                 \"holds\": bool(holds)})\n    return bool(holds)\n\n\n# THE headline requirement: canonical LOW/MEDIUM effect tier + P3 permission floor -> token required\nfor tier in (\"LOW\", \"MEDIUM\", \"HIGH\", \"CRITICAL\"):\n    r = req(effect_risk_tier=tier, permission_class=\"P3\", operation=\"read\")\n    run(f\"P3floor-{tier}\", f\"canonical effect_risk_tier={tier} + permission_class=P3 + benign + no token\",\n        lambda r=r: sat(gate(r), None, request=r, ctx=None), \"DENY_P3_TOKEN_REQUIRED\")\n    # Satisfiability is NOT re-tested here. The helper's token is signed for the DEFAULT request, so\n    # any request mutation necessarily yields DENY_EXACT_BINDING - that is the product enforcing exact\n    # binding correctly, not over-blocking. Reporting it as a probe failure would be a harness artifact.\n    # Satisfiability is instead proven by invoking the SHIPPED positive tests below.\n\n# canonical ruin independent of permission class\nfor tier, code in ((\"RUIN\", \"HARD_VETO_RUIN\"), (\"UNKNOWN_RUIN\", \"SAFE_STOP_UNKNOWN_RUIN\")):\n    r = req(effect_risk_tier=tier, permission_class=\"P1\", operation=\"read\")\n    run(f\"ruin-{tier}-lowperm\", f\"canonical effect_risk_tier={tier} even at P1 -> {code}\",\n        lambda r=r: sat(gate(r), None, request=r, ctx=None), code)\n\n# T3 autonomy must gate\nr = req(effect_risk_tier=\"LOW\", permission_class=\"P2\", autonomy_tier=\"T3\", operation=\"read\")\nrun(\"T3-gate\", \"autonomy_tier=T3 + benign + no token -> token required\",\n    lambda: sat(gate(r), None, request=r, ctx=None), \"DENY_P3_TOKEN_REQUIRED\")\n\n# satisfiability evidence: run the SHIPPED positive controls the way the suite runs them, i.e. with the\n# tests directory as top-level. An in-process loadTestsFromName fails on import context and would embed a\n# FALSE negative in the evidence, so invoke the real runner as a subprocess.\nimport subprocess  # noqa: E402\nTESTS_DIR = str(SWOF / \"src\" / \"security\" / \"tests\")\nPYEXE = sys.executable\npos = {}\nfor name in (\"TestRouteReDerivationR2.test_r2_12_p3_request_with_a_valid_typed_token_passes\",\n             \"TestCanonicalGatePredicateD1.test_r4_d1_05_p3_benign_operation_with_valid_token_passes\"):\n    r = subprocess.run([PYEXE, \"-m\", \"unittest\", f\"test_humangate_currentness.{name}\"],\n                       capture_output=True, text=True, cwd=TESTS_DIR)\n    pos[name] = {\"exit_code\": r.returncode, \"tail\": r.stderr.strip().splitlines()[-1:]}\n\nout = {\"schema\": \"SWOF-W2-R2-CANONICAL-FLOOR-PROBE/1\",\n       \"satisfiability_proof\": {\n           \"method\": \"SHIPPED positive tests are executed by the real unittest runner (cwd = the tests \"\n                     \"directory, the same top-level the full suite uses). A valid token bound to the SAME \"\n                     \"request must be satisfiable, so the product is proven NOT to be over-blocking.\",\n           \"shipped_positive_tests\": pos,\n           \"all_shipped_positive_tests_pass\": all(v[\"exit_code\"] == 0 for v in pos.values())},\n       \"subject\": \"3ade7d0edec5d3304672be2cfa696e570aaab193\",\n       \"rows\": rows, \"all_hold\": all(r[\"holds\"] for r in rows),\n       \"failures\": [r[\"probe\"] for r in rows if not r[\"holds\"]]}\np = Path(sys.argv[1]) if len(sys.argv) > 1 else Path(\"R2_CANONICAL_FLOOR_PROBE.json\")\np.write_text(json.dumps(out, ensure_ascii=False, indent=1, default=str) + \"\\n\", encoding=\"utf-8\")\nfor r in rows:\n    print(f\"{r['probe']:22s} holds={str(r['holds']):5s} {json.dumps(r['observed'], ensure_ascii=False)[:70]}\"\n          + (f\" RAISED={r['raised']}\" if r.get(\"raised\") else \"\"))\nprint(\"ALL HOLD:\", out[\"all_hold\"], \"| failures:\", out[\"failures\"])\n\r\n","exit_code":0,"status":"completed"}}
