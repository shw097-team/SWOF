ool:\r\n    q = p.replace(\"\\\\\", \"/\").lstrip(\"./\")\r\n    return any(q == g.rstrip(\"/\") or q.startswith(g) for g in ADMITTED)\r\n\r\n\r\ndef main():\r\n    LOGS.mkdir(parents=True, exist_ok=True)\r\n    head = git(\"rev-parse\", \"HEAD\").stdout.strip()\r\n    branch = git(\"rev-parse\", \"--abbrev-ref\", \"HEAD\").stdout.strip()\r\n    dirty = [l for l in git(\"status\", \"--porcelain\").stdout.splitlines() if l.strip()]\r\n    assert branch == BRANCH, f\"on {branch}, expected {BRANCH}\"\r\n    assert head == BASELINE, f\"HEAD {head} != frozen repair base {BASELINE}\"\r\n    assert BASELINE == \"7a0b4acbe14daca2061ba9b927013adf8aaf48b5\", \"R4 base must be the frozen R3 candidate\"\r\n    assert not dirty, f\"worktree dirty before mutation: {dirty[:3]}\"\r\n\r\n    spec = SPECS / \"R4_WO-SWOF-W2-R004_SPEC.md\"\r\n    assert spec.exists(), f\"missing spec {spec}\"\r\n    prompt = (\r\n        \"You are the tracked mutation writer for SWOF repair WorkOrder WO-SWOF-W2-R001. \"\r\n        f\"Read the specification at {spec} and implement EXACTLY what it requires. \"\r\n        \"You may create or modify files ONLY under these admitted paths: \"\r\n        f\"{', '.join(ADMITTED)}. Do not touch any other path in the repository, and never touch \"\r\n        \"HG-KSEOS, the knowledge base, or any other project. \"\r\n        \"Write ASCII only and use LF line endings. Python standard library only. \"\r\n        \"Run the focused tests yourself before finishing. \"\r\n        \"When finished, print one JSON object: \"\r\n        '{\"files\": [<every path you wrote>], \"test_command\": \"<the command you ran>\", '\r\n        '\"test_result\": \"<stdout tail>\", \"denominator\": <int tests collected in src/security/tests>}.')\r\n\r\n    env = dict(os.environ)\r\n    env[\"CODEX_HOME\"] = str(CODEHOME)\r\n    env[\"OPENCODEX_HOME\"] = str(OCXHOME)\r\n    argv = [str(CODEX), \"exec\", \"--cd\", str(T), \"--sandbox\", \"danger-full-access\",\r\n            \"-c\", \"approval_policy=never\", \"--json\", prompt]\r\n    started = time.time()\r\n    started_utc = time.strftime(\"%Y-%m-%dT%H:%M:%SZ\", time.gmtime())\r\n    p = subprocess.run(argv, capture_output=True, text=True, timeout=3600, env=env,\r\n                       cwd=str(Path(os.environ.get(\"LOCALAPPDATA\", \"\")) / \"Temp\"))\r\n    dur = time.time() - started\r\n    (LOGS / \"CODEX_WO-SWOF-W2-R004.jsonl\").write_text(\r\n        \"# command : codex exec --cd %s --sandbox danger-full-access -c approval_policy=never --json\\n\"\r\n        \"# workorder: WO-SWOF-W2-R001\\n# base: %s\\n# exit_code: %d\\n# duration: %.1fs\\n\"\r\n        \"# started_at_utc: %s\\n\" % (T, BASELINE, p.returncode, dur, started_utc)\r\n        + \"-\" * 78 + \"\\n\" + (p.stdout or \"\") + \"\\n\" + (p.stderr or \"\"),\r\n        encoding=\"utf-8\", newline=\"\\n\")\r\n\r\n    changed = [l.split()[-1] for l in git(\"status\", \"--porcelain\").stdout.splitlines() if l.strip()]\r\n    outside = [c for c in changed if not admitted(c)]\r\n    reverted = []\r\n    if outside:                                    # containment violation: revert, never keep\r\n        for c in outside:\r\n            git(\"checkout\", \"--\", c) if not (T / c).exists() or git(\r\n                \"ls-files\", \"--error-unmatch\", c).returncode == 0 else None\r\n            if (T / c).exists() and git(\"ls-files\", \"--error-unmatch\", c).returncode != 0:\r\n                (T / c).unlink()\r\n            reverted.append(c)\r\n        changed = [l.split()[-1] for l in git(\"status\", \"--porcelain\").stdout.splitlines() if l.strip()]\r\n\r\n    # focused tests\r\n    foc = subprocess.run([str(PY), \"-m\", \"unittest\", \"discover\", \"-s\", FOCUSED_ROOT, \"-t\", \".\", \"-v\"],\r\n                         cwd=str(T), capture_output=True, text=True, timeout=1800)\r\n    ran = sum(1 for l in (foc.stderr or \"\").splitlines() if l.startswith(\"test_\") and \"... \" in l)\r\n    (LOGS / \"FOCUSED_WO-SWOF-W2-R004.log\").write_text(\r\n        f\"# command: python -m unittest discover -s {FOCUSED_ROOT} -t . -v\\n\"\r\n        f\"# exit_code: {foc.returncode}\\n# tests_run: {ran}\\n\" + \"-\" * 78 + \"\\n\"\r\n        + (foc.stderr or \"\") + \"\\n\" + (foc.stdout or \"\"), encoding=\"utf-8\", newline=\"\\n\")\r\n\r\n    if foc.returncode == 0 and changed and not outside:\r\n        for c in changed:\r\n            git(\"add\", \"--\", c)\r\n        staged = [l for l in git(\"diff\", \"--cached\", \"--name-only\").stdout.splitlines() if l.strip()]\r\n        assert staged, \"nothing staged\"\r\n        assert all(admitted(s) for s in staged), f\"staged outside write-set: {staged}\"\r\n        git(\"commit\", \"-q\", \"-m\",\r\n            \"W2 closure repair R2: canonical risk/ruin gate + RFC8785/Ed25519 ApprovalToken integrity\")\r\n    new_head = git(\"rev-parse\", \"HEAD\").stdout.strip()\r\n    receipt = {\"workorder\": \"WO-SWOF-W2-R004\", \"repair_id\": \"SWOF-W2-CLOSURE-R2\",\r\n               \"base\": BASELINE, \"branch\": BRANCH, \"codex_exit\": p.returncode,\r\n               \"duration_s\": round(dur, 1), \"candidate\": new_head,\r\n               \"candidate_changed\": new_head != BASELINE,\r\n               \"containment_ok\": not outside, \"reverted\": reverted,\r\n               \"changed_paths\": changed,\r\n               \"focused\": {\"root\": FOCUSED_ROOT, \"ran\": ran, \"exit_code\": foc.returncode,\r\n                           \"raw_log\": f\"writer_logs/FOCUSED_WO-SWOF-W2-R004.log\"}}\r\n    (OUT / \"R4_APPLY_RECEIPT.json\").write_text(json.dumps(receipt, ensure_ascii=False, indent=1) + \"\\n\",\r\n                                               encoding=\"utf-8\")\r\n    print(json.dumps(receipt, ensure_ascii=False, indent=1))\r\n\r\n\r\nif __name__ == \"__main__\":\r\n","exit_code":0,"status":"completed"}}
