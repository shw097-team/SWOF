s in effect_risk_tier; no ruin_class attribute at all.\r\nfor val in (\"RUIN\", \"UNKNOWN_RUIN\"):\r\n    r = req(effect_risk_tier=val)\r\n    code = \"HARD_VETO_RUIN\" if val == \"RUIN\" else \"SAFE_STOP_UNKNOWN_RUIN\"\r\n    run(f\"C1-{val}\", f\"canonical effect_risk_tier={val} + BENIGN op + NO token -> must {code}\",\r\n        lambda r=r: sat(gate(r), None, request=r, ctx=None), code)\r\n    r2 = req(effect_risk_tier=val)\r\n    run(f\"C2-{val}\", f\"canonical effect_risk_tier={val} + VALID token -> token cannot override\",\r\n        lambda r=r2: sat(gate(r2), tok(), request=r2, ctx=ctx()), code)\r\n\r\n# canonical non-ruin tiers must be recognised as risk-bearing where the spec says so\r\nfor val in (\"CRITICAL\", \"HIGH\", \"MEDIUM\", \"LOW\"):\r\n    r = req(effect_risk_tier=val, permission_class=\"P2\", operation=\"read\")\r\n    try:\r\n        out = sat(gate(r), None, request=r, ctx=None)\r\n        blocked = False\r\n        detail = \"ungated\"\r\n    except Exception as e:  # noqa: BLE001\r\n        blocked, detail = True, f\"{type(e).__name__}:{str(e)[:40]}\"\r\n    rows.append({\"probe\": f\"C3-{val}\", \"case\": f\"effect_risk_tier={val} + P2 benign + no token\",\r\n                 \"expected\": \"OBSERVE\", \"observed\": {\"gated\": blocked, \"detail\": detail}, \"holds\": True})\r\n\r\n# malformed permission enum must fail closed (reject unknown enum values, never coerce)\r\nfor bad in (\"p3\", \"P3 \", \" P3\", \"\", \"P9\"):\r\n    r = req(effect_risk_tier=\"LOW\", permission_class=bad, operation=\"read\")\r\n    try:\r\n        sat(gate(r), None, request=r, ctx=None)\r\n        blocked = False\r\n    except Exception:  # noqa: BLE001\r\n        blocked = True\r\n    rows.append({\"probe\": f\"C4-perm({bad!r})\", \"case\": f\"permission_class={bad!r} (malformed) -> \"\r\n                 \"must fail CLOSED, not open\", \"expected\": True, \"observed\": {\"blocked\": blocked},\r\n                 \"holds\": bool(blocked is True)})\r\n\r\nout = {\"schema\": \"SWOF-W2-R2-CANONICAL-RUIN-PROBE/1\",\r\n       \"subject\": \"edb53142dda94e1b0e4926bebc008b06f42cbcfb\",\r\n       \"canonical_ruin_field\": \"effect_risk_tier (enum LOW|MEDIUM|HIGH|CRITICAL|RUIN|UNKNOWN_RUIN)\",\r\n       \"ruin_class_in_canonical_source\": False,\r\n       \"rows\": rows, \"all_hold\": all(r[\"holds\"] for r in rows),\r\n       \"failures\": [r[\"probe\"] for r in rows if not r[\"holds\"]]}\r\np = Path(sys.argv[1]) if len(sys.argv) > 1 else Path(\"R2_CANONICAL_RUIN_PROBE.json\")\r\np.write_text(json.dumps(out, ensure_ascii=False, indent=1, default=str) + \"\\n\", encoding=\"utf-8\")\r\nfor r in rows:\r\n    print(f\"{r['probe']:22s} holds={str(r['holds']):5s} {json.dumps(r['observed'], ensure_ascii=False)[:90]}\"\r\n          + (f\" RAISED={r['raised']}\" if r.get(\"raised\") else \"\"))\r\nprint(\"ALL HOLD:\", out[\"all_hold\"], \"| failures:\", out[\"failures\"])\r\n\r\n","exit_code":0,"status":"completed"}}
