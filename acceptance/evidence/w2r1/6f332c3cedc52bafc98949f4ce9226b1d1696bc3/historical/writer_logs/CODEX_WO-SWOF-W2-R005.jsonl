                               \r\nC:\\Projects\\Agent_Workspace\\SWOF\\src\\security\\__pycache__\\permissions.cpython-312.pyc                                  \r\nC:\\Projects\\Agent_Workspace\\SWOF\\src\\security\\__pycache__\\provenance.cpython-311.pyc                                   \r\nC:\\Projects\\Agent_Workspace\\SWOF\\src\\security\\__pycache__\\provenance.cpython-312.pyc                                   \r\nC:\\Projects\\Agent_Workspace\\SWOF\\src\\security\\__pycache__\\rights.cpython-311.pyc                                       \r\nC:\\Projects\\Agent_Workspace\\SWOF\\src\\security\\__pycache__\\rights.cpython-312.pyc                                       \r\nC:\\Projects\\Agent_Workspace\\SWOF\\src\\security\\__pycache__\\supplychain.cpython-311.pyc                                  \r\nC:\\Projects\\Agent_Workspace\\SWOF\\src\\security\\__pycache__\\supplychain.cpython-312.pyc                                  \r\nC:\\Projects\\Agent_Workspace\\SWOF\\src\\security\\__pycache__\\veto.cpython-311.pyc                                         \r\nC:\\Projects\\Agent_Workspace\\SWOF\\src\\security\\__pycache__\\veto.cpython-312.pyc                                         \r\nC:\\Projects\\Agent_Workspace\\SWOF\\schemas\\security\\approval_token.schema.json                                           \r\nC:\\Projects\\Agent_Workspace\\SWOF\\schemas\\security\\permission_envelope.schema.json                                      \r\nC:\\Projects\\Agent_Workspace\\SWOF\\schemas\\security\\README.md                                                            \r\nC:\\Projects\\Agent_Workspace\\SWOF\\schemas\\security\\rights_currentness.schema.json                                       \r\nC:\\Projects\\Agent_Workspace\\SWOF\\schemas\\security\\security_veto.schema.json                                            \r\n\r\n","exit_code":0,"status":"completed"}}
